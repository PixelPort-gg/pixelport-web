---
const path = Astro.url.pathname;
const nav = [
  { href: '/games', label: 'Games' },
  { href: '/docs', label: 'Docs' },
  { href: '/stats', label: 'Stats' },
  { href: '/blog', label: 'Blog' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const currentState = (href: string) =>
  path === href ? 'page' : path.startsWith(href + '/') ? 'location' : undefined;
---

<header class="site-header" data-site-header>
  <div class="mobile-backdrop" data-mobile-menu-backdrop hidden aria-hidden="true"></div>

  <div class="header-rail">
    <div class="brand-lockup">
      <a href="/" class="brand" aria-label="Pixel Port home">
        <span class="brand-mark">
          <img src="/brand/mark.svg" alt="" width="28" height="28" />
        </span>
        <span class="brand-name">Pixel Port</span>
      </a>
      <span class="brand-description">Run Windows Steam games on Apple Silicon Macs</span>
    </div>

    <div class="navigation-cluster">
      <nav class="desktop-nav" aria-label="Primary navigation">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={currentState(item.href)}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="header-actions">
        <a href="/download" class="download-link">
          <span>Download</span>
          <svg
            class="download-icon"
            viewBox="0 0 20 20"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <path d="M10 2.5v9.25m0 0 3.25-3.25M10 11.75 6.75 8.5M4 13.5v2.75h12V13.5" />
          </svg>
        </a>

        <div class="mobile-menu" data-mobile-menu>
          <button
            type="button"
            class="mobile-menu-button"
            data-mobile-menu-button
            aria-controls="mobile-primary-navigation"
            aria-expanded="false"
          >
            <span class="menu-label" data-mobile-menu-label>Open navigation menu</span>
            <span class="menu-lines" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
          </button>
          <nav
            id="mobile-primary-navigation"
            class="mobile-nav"
            data-mobile-menu-panel
            aria-label="Mobile navigation"
            hidden
          >
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class:list={['mobile-link', { active: isActive(item.href) }]}
                  aria-current={currentState(item.href)}
                >
                  <span>{item.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    const button = header.querySelector<HTMLButtonElement>('[data-mobile-menu-button]');
    const label = header.querySelector<HTMLElement>('[data-mobile-menu-label]');
    const panel = header.querySelector<HTMLElement>('[data-mobile-menu-panel]');
    const backdrop = header.querySelector<HTMLElement>('[data-mobile-menu-backdrop]');
    const mobileViewport = window.matchMedia('(max-width: 52rem)');

    if (menu && button && label && panel && backdrop) {
      const links = [...panel.querySelectorAll<HTMLAnchorElement>('a')];
      const isOpen = () => button.getAttribute('aria-expanded') === 'true';

      const closeMenu = (restoreFocus = true) => {
        if (!isOpen()) return;

        button.setAttribute('aria-expanded', 'false');
        label.textContent = 'Open navigation menu';
        panel.hidden = true;
        backdrop.hidden = true;
        delete header.dataset.menuOpen;

        if (restoreFocus && mobileViewport.matches) {
          button.focus({ preventScroll: true });
        }
      };

      const openMenu = () => {
        if (!mobileViewport.matches || isOpen()) return;

        button.setAttribute('aria-expanded', 'true');
        label.textContent = 'Close navigation menu';
        panel.hidden = false;
        backdrop.hidden = false;
        header.dataset.menuOpen = 'true';

        requestAnimationFrame(() => {
          if (isOpen()) links[0]?.focus({ preventScroll: true });
        });
      };

      button.addEventListener('click', () => {
        if (isOpen()) closeMenu();
        else openMenu();
      });

      for (const link of links) {
        link.addEventListener('click', () => closeMenu());
      }

      menu.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (isOpen() && next instanceof Node && !menu.contains(next)) {
          closeMenu(false);
        }
      });

      document.addEventListener('pointerdown', (event) => {
        const target = event.target;
        if (isOpen() && target instanceof Node && !menu.contains(target)) {
          closeMenu();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (!isOpen()) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          closeMenu();
        }
      });

      mobileViewport.addEventListener('change', (event) => {
        if (!event.matches) closeMenu(false);
      });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-base-bottom) 94%, transparent);
    backdrop-filter: blur(20px);
  }

  .header-rail {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(88rem, calc(100% - 2.5rem));
    height: 4.75rem;
    margin-inline: auto;
  }

  .brand-lockup,
  .navigation-cluster,
  .brand,
  .header-actions {
    display: flex;
    align-items: center;
  }

  .brand-lockup {
    min-width: 0;
  }

  .brand {
    flex: 0 0 auto;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: var(--color-fg);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-accent) 52%, var(--color-line));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
  }

  .brand-mark img {
    display: block;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 0.75rem;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .brand-description {
    overflow: hidden;
    max-width: 24rem;
    margin-left: 1.25rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .navigation-cluster {
    min-width: 0;
    margin-left: auto;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 4.75rem;
    padding-inline: 1rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 550;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-fg);
  }

  .nav-link::after {
    position: absolute;
    right: 0.9rem;
    bottom: -1px;
    left: 0.9rem;
    height: 2px;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    content: '';
    opacity: 0;
    transform: scaleX(0.45);
    transition:
      opacity 160ms ease,
      transform 160ms var(--ease-cinema);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    opacity: 0.45;
    transform: scaleX(0.72);
  }

  .nav-link.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .header-actions {
    gap: 0.6rem;
    margin-left: 0.75rem;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-2) 78%, var(--color-line));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-accent-2) 4%, transparent);
    color: var(--color-accent-2);
    font-size: 0.8125rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .download-link:hover,
  .download-link:focus-visible {
    border-color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 10%, transparent);
    color: var(--color-fg);
  }

  .download-link:active {
    transform: scale(0.98);
  }

  .download-icon {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .mobile-menu {
    position: relative;
    display: none;
  }

  .mobile-menu-button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: transparent;
    color: var(--color-fg);
  }

  .mobile-menu-button:hover {
    border-color: rgba(63, 214, 206, 0.42);
    background: color-mix(in srgb, var(--color-surface-2) 82%, transparent);
  }

  .menu-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .menu-lines {
    position: relative;
    display: block;
    width: 1.15rem;
    height: 0.75rem;
  }

  .menu-lines span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    border-radius: 999px;
    background: var(--color-fg);
    transition: transform 160ms var(--ease-cinema);
  }

  .menu-lines span:first-child {
    transform: translateY(-0.22rem);
  }

  .menu-lines span:last-child {
    transform: translateY(0.22rem);
  }

  [data-menu-open='true'] .menu-lines span:first-child {
    transform: rotate(45deg);
  }

  [data-menu-open='true'] .menu-lines span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgba(6, 4, 16, 0.56);
    pointer-events: auto;
  }

  .mobile-nav {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    z-index: 2;
    display: flex;
    width: min(18rem, calc(100vw - 2rem));
    flex-direction: column;
    padding: 0.65rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-surface) 96%, var(--color-base-bottom));
    box-shadow: 0 0.5rem 0.5rem rgba(6, 4, 16, 0.42);
  }

  .mobile-backdrop[hidden],
  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: 0.75rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .mobile-link:hover,
  .mobile-link.active {
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-fg);
  }

  @media (max-width: 70rem) {
    .brand-description {
      display: none;
    }
  }

  @media (max-width: 52rem) {
    .header-rail {
      width: min(100% - 1rem, 88rem);
      height: 4.25rem;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .brand-name {
      font-size: 1rem;
    }

    .download-link {
      padding-inline: 0.9rem;
      font-size: 0.8125rem;
    }

    .mobile-nav {
      top: calc(100% + 0.7rem);
      width: min(18rem, calc(100vw - 1rem));
    }
  }

  @media (max-width: 21rem) {
    .brand-name {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after,
    .download-link,
    .mobile-menu-button,
    .menu-lines span {
      transition: none;
    }
  }
</style>
