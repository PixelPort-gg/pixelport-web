---
const path = Astro.url.pathname;
const nav = [
  { href: '/games', label: 'Games' },
  { href: '/docs', label: 'Docs' },
  { href: '/stats', label: 'Stats' },
  { href: '/blog', label: 'Blog' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line bg-base-bottom/70 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="Pixel Port home">
      <img src="/brand/mark.svg" alt="" width="26" height="26" class="h-6.5 w-6.5" />
      <span class="font-semibold tracking-tight">Pixel Port</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm sm:flex">
      {
        nav.map((n) => (
          <a
            href={n.href}
            class:list={['transition-colors hover:text-fg', isActive(n.href) ? 'text-fg' : 'text-muted']}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/download"
        class="rounded-full bg-linear-to-r from-accent to-accent-2 px-4 py-2 text-sm font-semibold text-white shadow-[var(--shadow-glow)] [text-shadow:0_1px_2px_rgba(10,8,22,0.4)] transition-transform active:scale-[0.97]"
      >
        Download
      </a>

      <details class="relative sm:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-line [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <span class="relative block h-3 w-5">
            <span class="absolute left-0 top-0 h-0.5 w-5 rounded bg-fg"></span>
            <span class="absolute left-0 top-1.5 h-0.5 w-5 rounded bg-fg"></span>
            <span class="absolute left-0 top-3 h-0.5 w-5 rounded bg-fg"></span>
          </span>
        </summary>
        <nav
          class="absolute right-0 top-full mt-2 flex w-44 flex-col rounded-xl border border-line bg-surface p-2 text-sm shadow-[var(--shadow-glow)]"
        >
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'rounded-lg px-3 py-2 hover:bg-surface-2',
                  isActive(n.href) ? 'text-fg' : 'text-muted',
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
