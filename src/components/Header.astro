---
const path = Astro.url.pathname;
const nav = [
  { href: '/games', label: 'Games' },
  { href: '/docs', label: 'Docs' },
  { href: '/stats', label: 'Stats' },
  { href: '/blog', label: 'Blog' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line bg-base-bottom/70 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="Pixel Port home">
      <img src="/brand/mark.svg" alt="" width="26" height="26" class="h-6.5 w-6.5" />
      <span class="font-semibold tracking-tight">Pixel Port</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm sm:flex">
      {
        nav.map((n) => (
          <a
            href={n.href}
            class:list={[
              'transition-colors hover:text-fg',
              isActive(n.href) ? 'text-fg' : 'text-muted',
            ]}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/#download"
      class="rounded-full bg-linear-to-r from-accent to-accent-2 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-black/30 transition-transform active:scale-[0.97]"
    >
      Download
    </a>
  </div>
</header>
