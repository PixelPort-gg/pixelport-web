---
/**
 * Reveal: fade + ~12px rise as the slotted content scrolls into view, once.
 *
 * Premium, restrained: a single IntersectionObserver pass, no looping motion.
 * Reduced-motion or no-JS → content is simply visible (never hidden).
 *
 * Props:
 *   delay - ms before the reveal starts (for staggering siblings)
 *   as    - wrapper tag (default "div")
 *   class - extra classes are merged onto the wrapper
 *
 * Safe to use many times on a page: one shared, guarded observer wires every
 * instance, and the initial-hidden state is only applied once JS confirms
 * support (so it can never trap content behind a broken script).
 */
interface Props {
  delay?: number;
  as?: keyof astroHTML.JSX.IntrinsicElements;
  class?: string;
}
const { delay = 0, as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={['reveal', className]}
  data-reveal
  style={`--reveal-delay:${delay}ms`}
  {...rest}
>
  <slot />
</Tag>

<style>
  /* Default (no-JS, or before JS runs): fully visible. Never hide content
     unless JS has proven it can reveal it again. */
  @media (prefers-reduced-motion: no-preference) {
    html.reveal-js .reveal {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }
    html.reveal-js .reveal.is-visible {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script is:inline>
  (() => {
    // Mark the root synchronously so the initial-hidden state applies before
    // first paint (idempotent across every Reveal instance).
    document.documentElement.classList.add('reveal-js');

    if (window.__pixelRevealInit) return;
    window.__pixelRevealInit = true;

    const start = () => {
      const els = document.querySelectorAll('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
      );

      els.forEach((el) => io.observe(el));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
</script>
