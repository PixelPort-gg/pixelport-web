---
import { Picture } from 'astro:assets';
import heroBackdrop from '../../assets/hero/home-portal-hero.png';
import PortalFrame from './PortalFrame.astro';

type HeroGame = {
  appid: number | null;
  slug: string;
  title: string;
  tier: string;
};

// A partner placement marks the lead game as paid: the compatibility link
// carries data-placement / data-surface for the anonymous beacon, rel=sponsored,
// and a visible Partner chip.
type PlacementTag = { id: string; surface: string; label: string };

interface Props {
  games: HeroGame[];
  placement?: PlacementTag;
}

const { games, placement } = Astro.props;
const lead = games[0];
const partnerLabel = placement?.label?.trim() || 'Partner';
// Mirror-first art chain (see ProofRail): mirror → Steam library art → Steam header.
const cover = (appid: number | null) =>
  appid ? 'https://mgp-api.macgameport.workers.dev/art/' + appid + '.jpg' : null;
const header = (appid: number | null) =>
  appid
    ? 'https://cdn.cloudflare.steamstatic.com/steam/apps/' + appid + '/library_600x900.jpg|' +
      'https://cdn.cloudflare.steamstatic.com/steam/apps/' + appid + '/header.jpg'
    : null;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-scene" aria-hidden="true">
    <Picture
      src={heroBackdrop}
      formats={['avif']}
      fallbackFormat="webp"
      alt=""
      layout="full-width"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-scene-image"
    />
  </div>

  <div class="hero-viewport">
    <div class="hero-layout wrap">
      <div class="hero-copy">
      <a href="/mac/palworld-1623730/" class="announcement">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="announcement-copy">
          <strong>Palworld 1.0</strong>
          <span class="announcement-desktop"> is here. Play the Steam copy you already own on your Mac.</span>
          <span class="announcement-mobile"> is ready on Mac.</span>
        </span>
        <span class="announcement-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <h1 id="hero-title">Game on Mac with a single click.</h1>
      <p class="lede">
        Play supported Windows Steam games on Apple Silicon Mac with one-click setup: no Wine
        bottles, virtual machines, partitions, or terminal.
      </p>

      <div class="actions">
        <a href="/download" class="button button--primary" aria-label="Download the latest Pixel Port DMG">
          <span class="button-label-desktop">Download latest .dmg</span>
          <span class="button-label-mobile">Download for Mac</span>
        </a>
        <a href="/games" class="button button--secondary" aria-label="Browse compatible games">
          <span class="button-label-desktop">See what runs</span>
          <span class="button-label-mobile">Browse games</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      </div>

      <div class="hero-visual">
        <PortalFrame>
          <div class="launch-crossing" aria-hidden="true">
          {
            lead ? (
              <div class="source-game" aria-hidden="true">
                <span class="source-label">Your Steam game</span>
                <span class="source-art">
                  <span class="art-fallback">{lead.title}</span>
                  {cover(lead.appid) && (
                    <img
                      src={cover(lead.appid)}
                      data-fallback={header(lead.appid)}
                      alt=""
                      width="240"
                      height="360"
                      decoding="async"
                      fetchpriority="high"
                    />
                  )}
                </span>
                <strong>{lead.title}</strong>
              </div>
            ) : (
              <div class="source-game source-game--fallback" aria-hidden="true">
                <span class="source-label">Your Steam game</span>
                <span class="source-art"><span class="art-fallback">Windows game</span></span>
              </div>
            )
          }

          <div class="portal-mark" aria-hidden="true">
            <span class="mark-orbit"></span>
            <img src="/brand/mark.svg" alt="" width="104" height="104" />
          </div>

          <div class="ready-panel">
            <div class="ready-panel-content">
              <span class="ready-status"><span aria-hidden="true">&#10003;</span> Ready on Mac</span>
              <strong>{lead?.title ?? 'Your game'}</strong>
              <p>Pixel Port prepared the runtime and launch settings.</p>
              <span class="availability-note">
                <span class="availability-mark" aria-hidden="true"></span>
                Launches from the Pixel Port app
              </span>
            </div>
          </div>
          </div>
        </PortalFrame>
        <div class="visual-footer">
          <p class="visual-caption">
            <span class="visual-caption-desktop">A real Windows game goes in. A Mac-ready launch comes out.</span>
            <span class="visual-caption-mobile">Your Steam game in. A Mac-ready launch out.</span>
          </p>
          {
            lead && (
              <a
                href={'/games/' + lead.slug}
                class="visual-link"
                rel={placement ? 'sponsored' : undefined}
                data-placement={placement?.id}
                data-surface={placement?.surface}
              >
                {placement && <span class="partner-chip">{partnerLabel}</span>}
                <span class="visual-link-text">
                  {lead.title} compatibility <span aria-hidden="true">&rarr;</span>
                </span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<aside class="trust-band" aria-label="Download and compatibility details">
  <dl class="trust wrap">
    <div>
      <dt>Download</dt>
      <dd>Latest DMG · Apple Silicon</dd>
    </div>
    <div>
      <dt>Runs on</dt>
      <dd>Apple Silicon (M1+) · macOS 14+</dd>
    </div>
    <div>
      <dt>Your library</dt>
      <dd>Uses Steam games you own</dd>
    </div>
    <div>
      <dt>Privacy</dt>
      <dd><a href="/privacy">Analytics off by default</a></dd>
    </div>
  </dl>
</aside>

<script>
  for (const img of document.querySelectorAll<HTMLImageElement>('.source-game img[data-fallback]')) {
    img.addEventListener('error', () => {
      const chain = (img.dataset.fallback || '').split('|').filter(Boolean);
      const next = chain.shift();
      if (next) {
        img.dataset.fallback = chain.join('|');
        img.src = next;
      } else {
        img.remove();
      }
    });
  }
</script>

<style>
  .hero {
    --header-height: 4.75rem;

    position: relative;
    isolation: isolate;
    display: grid;
    min-height: calc(100svh - var(--header-height));
    align-items: stretch;
    background: var(--color-base-bottom);
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-scene :global(picture),
  .hero-scene :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-scene :global(img) {
    object-fit: cover;
    object-position: 50% 52%;
    opacity: 0.9;
  }

  .hero-scene::before,
  .hero-scene::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: '';
  }

  .hero-scene::before {
    background:
      linear-gradient(
        90deg,
        rgb(6 4 16 / 0.86) 0%,
        rgb(6 4 16 / 0.74) 25%,
        rgb(6 4 16 / 0.52) 43%,
        rgb(6 4 16 / 0.24) 62%,
        rgb(6 4 16 / 0.12) 82%,
        rgb(6 4 16 / 0.34) 100%
      ),
      linear-gradient(
        180deg,
        rgb(6 4 16 / 0.2) 0%,
        transparent 46%,
        rgb(6 4 16 / 0.9) 100%
      );
  }

  .hero-scene::after {
    z-index: 2;
    background:
      radial-gradient(ellipse at 67% 42%, rgba(146, 104, 255, 0.1), transparent 34%),
      radial-gradient(ellipse at 84% 48%, rgba(63, 214, 206, 0.055), transparent 32%);
  }

  .hero-viewport {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    min-width: 0;
    min-height: calc(100svh - var(--header-height));
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .hero-layout {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.25rem);
  }

  .hero-copy,
  .hero-visual {
    min-width: 0;
  }

  .announcement {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2rem;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .announcement:hover strong,
  .announcement:focus-visible strong {
    color: var(--color-accent-2);
  }

  .announcement-arrow {
    color: var(--color-accent-2);
    transition: transform 180ms ease;
  }

  .announcement:hover .announcement-arrow,
  .announcement:focus-visible .announcement-arrow {
    transform: translateX(3px);
  }

  .announcement-mobile,
  .button-label-mobile,
  .visual-caption-mobile {
    display: none;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: 0 0 10px rgba(63, 214, 206, 0.65);
  }

  h1 {
    max-width: 10ch;
    margin: 0;
    color: var(--color-fg);
    font-size: clamp(3rem, 6.5vw, 5.65rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .lede {
    max-width: 40rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.78rem 1.35rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 160ms ease, filter 160ms ease, border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button:active {
    transform: translateY(0);
  }

  .button--primary {
    background: var(--color-accent-2);
    color: var(--color-ink);
  }

  .button--primary:hover {
    filter: brightness(1.08);
  }

  .button--secondary {
    border: 1px solid var(--color-line);
    background: #100d21;
    color: var(--color-fg);
  }

  .button--secondary:hover {
    border-color: rgba(146, 104, 255, 0.52);
  }

  .trust-band {
    border-block: 1px solid var(--color-line);
    background: #080614;
  }

  .trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin-block: 0;
    padding-block: 1.5rem;
  }

  .trust div {
    min-width: 0;
  }

  .trust dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .trust dd {
    margin: 0.25rem 0 0;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .trust a {
    color: var(--color-accent-2);
    text-underline-offset: 3px;
  }

  .hero-visual :global(.portal-frame) {
    width: 100%;
    min-height: 420px;
    aspect-ratio: 16 / 11;
    background-color: rgb(9 7 23 / 0.78);
  }

  .launch-crossing {
    position: relative;
    display: grid;
    min-height: 420px;
    height: 100%;
    grid-template-columns: minmax(100px, 0.78fr) minmax(78px, 0.45fr) minmax(150px, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: center;
    padding: clamp(1.35rem, 3vw, 2.25rem);
  }

  .source-game {
    z-index: 2;
    display: grid;
    min-width: 0;
    justify-items: center;
    color: var(--color-fg);
    pointer-events: none;
    text-align: center;
  }

  .source-label {
    margin-bottom: 0.65rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .source-art {
    position: relative;
    z-index: 1;
    display: block;
    overflow: hidden;
    width: min(100%, 146px);
    aspect-ratio: 2 / 3;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-accent) 72%, var(--color-surface)),
      color-mix(in srgb, var(--color-accent-2) 58%, var(--color-surface))
    );
    box-shadow: 0 24px 40px -28px color-mix(in srgb, var(--color-base-bottom) 95%, transparent);
  }

  .source-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0.75rem;
    font-weight: 700;
  }

  .source-game > strong {
    overflow: hidden;
    width: 100%;
    margin-top: 0.7rem;
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .portal-mark {
    position: relative;
    z-index: 3;
    display: grid;
    width: clamp(72px, 10vw, 108px);
    aspect-ratio: 1;
    place-items: center;
    justify-self: center;
  }

  .portal-mark::before,
  .mark-orbit {
    position: absolute;
    border-radius: 50%;
    content: '';
  }

  .portal-mark::before {
    inset: -16%;
    border: 1px solid rgba(146, 104, 255, 0.5);
    border-right-color: rgba(63, 214, 206, 0.72);
    box-shadow: 0 0 32px rgba(146, 104, 255, 0.25);
  }

  .mark-orbit {
    inset: 2%;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .portal-mark img {
    position: relative;
    width: 72%;
    height: 72%;
    filter: drop-shadow(0 10px 18px rgba(146, 104, 255, 0.36));
  }

  .ready-panel {
    z-index: 2;
    min-width: 0;
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    border: 1px solid rgba(63, 214, 206, 0.24);
    border-radius: 12px;
    background: #101526;
  }

  .ready-panel-content {
    min-width: 0;
  }

  .ready-status {
    color: var(--color-verified);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .ready-panel-content > strong {
    display: block;
    overflow: hidden;
    margin-top: 0.65rem;
    font-size: clamp(1.35rem, 3.2vw, 2.35rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ready-panel-content p {
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .availability-note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.2rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 550;
  }

  .availability-mark {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-2) 12%, transparent);
  }

  .visual-footer {
    display: flex;
    min-height: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .visual-caption {
    min-width: 0;
    max-width: 34rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .visual-link {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.5rem;
    align-items: center;
    color: var(--color-accent-2);
    font-size: 0.75rem;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .visual-link .partner-chip {
    text-decoration: none;
  }

  /* Partner chip: same pill language as the tier badge, neutral colour so a
     paid slot never borrows the verified or playable colours. */
  .partner-chip {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.4rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: #090717;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  @keyframes source-crossing {
    0%,
    12% {
      clip-path: inset(0 round 12px);
      filter: brightness(1) saturate(1);
      opacity: 1;
      transform: translateX(0) rotate(-2deg) scale(1);
    }
    36% {
      clip-path: inset(0 round 12px);
      filter: brightness(1.03) saturate(1.05);
      opacity: 1;
      transform: translateX(14cqi) rotate(-1deg) scale(0.98);
    }
    50% {
      clip-path: inset(0 round 12px);
      filter: brightness(1.18) saturate(1.12);
      opacity: 1;
      transform: translateX(25cqi) rotate(0) scale(0.88);
    }
    60% {
      clip-path: inset(8% 2% round 12px);
      filter: brightness(1.38) saturate(0.78);
      opacity: 0.78;
      transform: translateX(33cqi) rotate(1deg) scale(0.72);
    }
    76% {
      clip-path: inset(18% 4% round 12px);
      filter: brightness(1.25) saturate(0.62);
      opacity: 0.16;
      transform: translateX(47cqi) rotate(0) scale(0.56);
    }
    100% {
      clip-path: inset(24% 5% round 12px);
      filter: brightness(1) saturate(1);
      opacity: 0;
      transform: translateX(52cqi) rotate(0) scale(0.5);
    }
  }

  @keyframes portal-charge {
    0%,
    16% {
      filter: brightness(0.92);
      opacity: 0.72;
      transform: scale(0.88);
    }
    42% {
      filter: brightness(1.08);
      opacity: 0.96;
      transform: scale(1.02);
    }
    54% {
      filter: brightness(1.4);
      opacity: 1;
      transform: scale(1.24);
    }
    70% {
      filter: brightness(1.12);
      opacity: 1;
      transform: scale(1.06);
    }
    100% {
      filter: brightness(1);
      opacity: 0.88;
      transform: scale(0.95);
    }
  }

  @keyframes portal-energy-cycle {
    0%,
    18% {
      --portal-energy: 0;
    }
    50% {
      --portal-energy: 0.72;
    }
    60% {
      --portal-energy: 1;
    }
    100% {
      --portal-energy: 0.28;
    }
  }

  @keyframes result-resolution {
    0%,
    48% {
      opacity: 0.24;
      transform: translateX(-0.8rem) scale(0.985);
    }
    64% {
      opacity: 0.48;
      transform: translateX(-0.55rem) scale(0.99);
    }
    78%,
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes source-label-settle {
    0%,
    26% {
      opacity: 1;
    }
    58% {
      opacity: 0.5;
    }
    100% {
      opacity: 0.3;
    }
  }

  @supports (animation-timeline: view()) and (animation-range: contain 0% contain 100%) {
    @media (min-width: 980px) and (min-height: 680px) and (prefers-reduced-motion: no-preference) {
      .hero {
        align-items: start;
        min-height: 175svh;
        padding-block: 0;
        view-timeline-name: --hero-passage;
        view-timeline-axis: block;
      }

      .hero-scene,
      .hero-viewport {
        grid-area: 1 / 1;
      }

      .hero-scene {
        position: sticky;
        top: 0;
        height: 100svh;
        align-self: start;
      }

      .hero-viewport {
        position: sticky;
        top: var(--header-height);
        box-sizing: border-box;
        height: calc(100svh - var(--header-height));
        min-height: 0;
        align-self: start;
        padding-block: clamp(3rem, 6vh, 4rem);
      }

      .announcement {
        margin-bottom: 1.25rem;
      }

      h1 {
        font-size: clamp(3rem, 5.6vw, 4.9rem);
      }

      .lede {
        margin-top: 1.15rem;
        font-size: clamp(1rem, 1.25vw, 1.1rem);
        line-height: 1.58;
      }

      .actions {
        margin-top: 1.4rem;
      }

      .source-game {
        position: relative;
      }

      .source-game::before {
        position: absolute;
        top: 1.8rem;
        left: 50%;
        width: min(100%, 146px);
        aspect-ratio: 2 / 3;
        border: 1px solid rgba(146, 104, 255, 0.2);
        border-radius: 12px;
        background: rgba(146, 104, 255, 0.035);
        content: '';
        transform: translateX(-50%);
      }

      .source-art {
        animation: source-crossing 1s linear both;
        transform-origin: center;
      }

      .source-label,
      .source-game > strong {
        animation: source-label-settle 1s linear both;
      }

      .portal-mark {
        animation: portal-charge 1s linear both;
      }

      .hero-visual :global(.portal-frame) {
        animation: portal-energy-cycle 1s linear both;
      }

      .ready-panel-content {
        animation: result-resolution 1s linear both;
        transform-origin: left center;
      }

      .source-art,
      .source-label,
      .source-game > strong,
      .portal-mark,
      .hero-visual :global(.portal-frame),
      .ready-panel-content {
        animation-timeline: --hero-passage;
        animation-range: contain 0% contain 100%;
      }
    }
  }

  @media (min-width: 980px) {
    .hero-layout {
      flex-direction: row;
      align-items: flex-start;
      gap: clamp(3rem, 6vw, 5.5rem);
    }

    .hero-copy {
      flex: 0.9 1 0;
    }

    .hero-visual {
      min-width: 31.25rem;
      flex: 1.1 1 0;
    }

    .trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 4rem);
    }
  }

  @media (min-width: 980px) and (max-width: 1099px) {
    .ready-panel {
      padding: 1rem;
    }

    .ready-panel-content > strong {
