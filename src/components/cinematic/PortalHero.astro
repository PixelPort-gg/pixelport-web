---
import PortalFrame from './PortalFrame.astro';

type HeroGame = {
  appid: number | null;
  slug: string;
  title: string;
  tier: string;
};

interface Props {
  games: HeroGame[];
}

const { games } = Astro.props;
const lead = games[0];
const cover = (appid: number | null) =>
  appid ? 'https://cdn.cloudflare.steamstatic.com/steam/apps/' + appid + '/library_600x900.jpg' : null;
const header = (appid: number | null) =>
  appid ? 'https://cdn.cloudflare.steamstatic.com/steam/apps/' + appid + '/header.jpg' : null;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-layout wrap">
    <div class="hero-copy">
      <a href="/mac/palworld-1623730/" class="announcement">
        <span class="live-dot" aria-hidden="true"></span>
        <span><strong>Palworld 1.0 is here.</strong> Play the Steam copy you already own on your Mac.</span>
        <span class="announcement-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <h1 id="hero-title">Game on Mac with a single click.</h1>
      <p class="lede">
        Pixel Port runs supported Windows games you own through Steam on Apple Silicon. Pick a
        graded game and it prepares the free runtime, applies the launch settings, and opens it.
        No bottles, virtual machine, partition, or terminal setup.
      </p>

      <div class="actions">
        <a href="/download" class="button button--primary">Download latest .dmg</a>
        <a href="/games" class="button button--secondary">See what runs <span aria-hidden="true">&rarr;</span></a>
      </div>

      <dl class="trust" aria-label="Download and compatibility details">
        <div>
          <dt>Download</dt>
          <dd>Latest DMG · free during beta</dd>
        </div>
        <div>
          <dt>Runs on</dt>
          <dd>Apple Silicon (M1+) · macOS 14+</dd>
        </div>
        <div>
          <dt>Your library</dt>
          <dd>Uses Steam games you own</dd>
        </div>
        <div>
          <dt>Privacy</dt>
          <dd><a href="/privacy">Anonymous by default</a></dd>
        </div>
      </dl>
    </div>

    <div class="hero-visual">
      <PortalFrame>
        <div class="launch-crossing" aria-hidden="true">
          {
            lead ? (
              <div class="source-game" aria-hidden="true">
                <span class="source-label">Your Steam game</span>
                <span class="source-art">
                  <span class="art-fallback">{lead.title}</span>
                  {cover(lead.appid) && (
                    <img
                      src={cover(lead.appid)}
                      data-fallback={header(lead.appid)}
                      alt=""
                      width="240"
                      height="360"
                      decoding="async"
                      fetchpriority="high"
                    />
                  )}
                </span>
                <strong>{lead.title}</strong>
              </div>
            ) : (
              <div class="source-game source-game--fallback" aria-hidden="true">
                <span class="source-label">Your Steam game</span>
                <span class="source-art"><span class="art-fallback">Windows game</span></span>
              </div>
            )
          }

          <div class="portal-mark" aria-hidden="true">
            <span class="mark-orbit"></span>
            <img src="/brand/mark.svg" alt="" width="104" height="104" />
          </div>

          <div class="ready-panel">
            <div class="ready-panel-content">
              <span class="ready-status"><span aria-hidden="true">&#10003;</span> Ready on Mac</span>
              <strong>{lead?.title ?? 'Your game'}</strong>
              <p>Pixel Port prepared the free runtime and launch settings.</p>
              <span class="launch-action">Launch game <span aria-hidden="true">&#9654;</span></span>
            </div>
          </div>
        </div>
      </PortalFrame>
      <div class="visual-footer">
        <p class="visual-caption">A real Windows game goes in. A Mac-ready launch comes out.</p>
        {
          lead && (
            <a href={'/games/' + lead.slug} class="visual-link">
              {lead.title} compatibility <span aria-hidden="true">&rarr;</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  for (const img of document.querySelectorAll<HTMLImageElement>('.source-game img[data-fallback]')) {
    img.addEventListener('error', () => {
      const fallback = img.dataset.fallback;
      if (fallback) {
        img.dataset.fallback = '';
        img.src = fallback;
      } else {
        img.remove();
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: calc(100svh - 4rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 74% 34%, rgba(146, 104, 255, 0.1), transparent 43%),
      radial-gradient(ellipse at 60% 72%, rgba(63, 214, 206, 0.045), transparent 40%);
    content: '';
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    min-width: 0;
    gap: clamp(3rem, 6vw, 5.5rem);
    align-items: center;
  }

  .hero-copy,
  .hero-visual {
    min-width: 0;
  }

  .announcement {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2rem;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .announcement:hover strong,
  .announcement:focus-visible strong {
    color: var(--color-accent-2);
  }

  .announcement-arrow {
    color: var(--color-accent-2);
    transition: transform 180ms ease;
  }

  .announcement:hover .announcement-arrow,
  .announcement:focus-visible .announcement-arrow {
    transform: translateX(3px);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: 0 0 10px rgba(63, 214, 206, 0.65);
  }

  h1 {
    max-width: 10ch;
    margin: 0;
    color: var(--color-fg);
    font-size: clamp(3rem, 6.5vw, 5.65rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .lede {
    max-width: 40rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.78rem 1.35rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 160ms ease, filter 160ms ease, border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button:active {
    transform: translateY(0);
  }

  .button--primary {
    background: var(--color-accent-2);
    color: var(--color-ink);
  }

  .button--primary:hover {
    filter: brightness(1.08);
  }

  .button--secondary {
    border: 1px solid var(--color-line);
    background: #100d21;
    color: var(--color-fg);
  }

  .button--secondary:hover {
    border-color: rgba(146, 104, 255, 0.52);
  }

  .trust {
    display: grid;
    max-width: 43rem;
    gap: 0.9rem 1.5rem;
    margin: 1.7rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .trust div {
    min-width: 0;
  }

  .trust dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .trust dd {
    margin: 0.18rem 0 0;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .trust a {
    color: var(--color-accent-2);
    text-underline-offset: 3px;
  }

  .hero-visual :global(.portal-frame) {
    width: 100%;
    min-height: 420px;
    aspect-ratio: 16 / 11;
  }

  .launch-crossing {
    position: relative;
    display: grid;
    min-height: 420px;
    height: 100%;
    grid-template-columns: minmax(100px, 0.78fr) minmax(78px, 0.45fr) minmax(150px, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: center;
    padding: clamp(1.35rem, 3vw, 2.25rem);
  }

  .source-game {
    z-index: 2;
    display: grid;
    min-width: 0;
    justify-items: center;
    color: var(--color-fg);
    pointer-events: none;
    text-align: center;
  }

  .source-label {
    margin-bottom: 0.65rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .source-art {
    position: relative;
    z-index: 1;
    display: block;
    overflow: hidden;
    width: min(100%, 146px);
    aspect-ratio: 2 / 3;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    background: linear-gradient(145deg, #5c40b0, #228c86);
    box-shadow: 0 24px 40px -28px rgba(0, 0, 0, 0.95);
  }

  .source-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0.75rem;
    font-weight: 700;
  }

  .source-game > strong {
    overflow: hidden;
    width: 100%;
    margin-top: 0.7rem;
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .portal-mark {
    position: relative;
    z-index: 3;
    display: grid;
    width: clamp(72px, 10vw, 108px);
    aspect-ratio: 1;
    place-items: center;
    justify-self: center;
  }

  .portal-mark::before,
  .mark-orbit {
    position: absolute;
    border-radius: 50%;
    content: '';
  }

  .portal-mark::before {
    inset: -16%;
    border: 1px solid rgba(146, 104, 255, 0.5);
    border-right-color: rgba(63, 214, 206, 0.72);
    box-shadow: 0 0 32px rgba(146, 104, 255, 0.25);
  }

  .mark-orbit {
    inset: 2%;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .portal-mark img {
    position: relative;
    width: 72%;
    height: 72%;
    filter: drop-shadow(0 10px 18px rgba(146, 104, 255, 0.36));
  }

  .ready-panel {
    z-index: 2;
    min-width: 0;
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    border: 1px solid rgba(63, 214, 206, 0.24);
    border-radius: 14px;
    background: #101526;
  }

  .ready-panel-content {
    min-width: 0;
  }

  .ready-status {
    color: var(--color-verified);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .ready-panel-content > strong {
    display: block;
    overflow: hidden;
    margin-top: 0.65rem;
    font-size: clamp(1.35rem, 3.2vw, 2.35rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ready-panel-content p {
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .launch-action {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.2rem;
    padding: 0.7rem 0.9rem;
    border-radius: 999px;
    background: var(--color-accent-2);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 750;
  }

  .visual-footer {
    display: flex;
    min-height: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .visual-caption {
    min-width: 0;
    max-width: 34rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .visual-link {
    flex: 0 0 auto;
    color: var(--color-accent-2);
    font-size: 0.75rem;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  @keyframes source-crossing {
    0%,
    12% {
      clip-path: inset(0 round 12px);
      filter: brightness(1) saturate(1);
      opacity: 1;
      transform: translateX(0) rotate(-2deg) scale(1);
    }
    36% {
      clip-path: inset(0 round 12px);
      filter: brightness(1.03) saturate(1.05);
      opacity: 1;
      transform: translateX(14cqi) rotate(-1deg) scale(0.98);
    }
    50% {
      clip-path: inset(0 round 12px);
      filter: brightness(1.18) saturate(1.12);
      opacity: 1;
      transform: translateX(25cqi) rotate(0) scale(0.88);
    }
    60% {
      clip-path: inset(8% 2% round 12px);
      filter: brightness(1.38) saturate(0.78);
      opacity: 0.78;
      transform: translateX(33cqi) rotate(1deg) scale(0.72);
    }
    76% {
      clip-path: inset(18% 4% round 12px);
      filter: brightness(1.25) saturate(0.62);
      opacity: 0.16;
      transform: translateX(47cqi) rotate(0) scale(0.56);
    }
    100% {
      clip-path: inset(24% 5% round 12px);
      filter: brightness(1) saturate(1);
      opacity: 0;
      transform: translateX(52cqi) rotate(0) scale(0.5);
    }
  }

  @keyframes portal-charge {
    0%,
    16% {
      filter: brightness(0.92);
      opacity: 0.72;
      transform: scale(0.88);
    }
    42% {
      filter: brightness(1.08);
      opacity: 0.96;
      transform: scale(1.02);
    }
    54% {
      filter: brightness(1.4);
      opacity: 1;
      transform: scale(1.24);
    }
    70% {
      filter: brightness(1.12);
      opacity: 1;
      transform: scale(1.06);
    }
    100% {
      filter: brightness(1);
      opacity: 0.88;
      transform: scale(0.95);
    }
  }

  @keyframes portal-energy-cycle {
    0%,
    18% {
      --portal-energy: 0;
    }
    50% {
      --portal-energy: 0.72;
    }
    60% {
      --portal-energy: 1;
    }
    100% {
      --portal-energy: 0.28;
    }
  }

  @keyframes result-resolution {
    0%,
    48% {
      opacity: 0;
      transform: translateX(-1.5rem) scale(0.97);
    }
    64% {
      opacity: 0.48;
      transform: translateX(-0.55rem) scale(0.99);
    }
    78%,
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes source-label-settle {
    0%,
    26% {
      opacity: 1;
    }
    58% {
      opacity: 0.5;
    }
    100% {
      opacity: 0.3;
    }
  }

  @supports (animation-timeline: view()) and (animation-range: contain 0% contain 100%) {
    @media (min-width: 980px) and (min-height: 680px) and (prefers-reduced-motion: no-preference) {
      .hero {
        align-items: start;
        min-height: 175svh;
        padding-block: 0;
        view-timeline-name: --hero-passage;
        view-timeline-axis: block;
      }

      .hero-layout {
        position: sticky;
        top: 0;
        box-sizing: border-box;
        height: 100svh;
        min-height: 100svh;
        padding-block: clamp(4.25rem, 8vh, 5rem) clamp(1.25rem, 3vh, 2rem);
      }

      .announcement {
        margin-bottom: 1.25rem;
      }

      h1 {
        font-size: clamp(3rem, 5.6vw, 4.9rem);
      }

      .lede {
        margin-top: 1.15rem;
        font-size: clamp(1rem, 1.25vw, 1.1rem);
        line-height: 1.58;
      }

      .actions {
        margin-top: 1.4rem;
      }

      .trust {
        gap: 0.7rem 1.5rem;
        margin-top: 1.2rem;
        padding-top: 0.95rem;
      }

      .source-game {
        position: relative;
      }

      .source-game::before {
        position: absolute;
        top: 1.8rem;
        left: 50%;
        width: min(100%, 146px);
        aspect-ratio: 2 / 3;
        border: 1px solid rgba(146, 104, 255, 0.2);
        border-radius: 12px;
        background: rgba(146, 104, 255, 0.035);
        content: '';
        transform: translateX(-50%);
      }

      .source-art {
        animation: source-crossing 1s linear both;
        transform-origin: center;
      }

      .source-label,
      .source-game > strong {
        animation: source-label-settle 1s linear both;
      }

      .portal-mark {
        animation: portal-charge 1s linear both;
      }

      .hero-visual :global(.portal-frame) {
        animation: portal-energy-cycle 1s linear both;
      }

      .ready-panel-content {
        animation: result-resolution 1s linear both;
        transform-origin: left center;
      }

      .source-art,
      .source-label,
      .source-game > strong,
      .portal-mark,
      .hero-visual :global(.portal-frame),
      .ready-panel-content {
        animation-timeline: --hero-passage;
        animation-range: contain 0% contain 100%;
      }
    }
  }

  @media (min-width: 980px) {
    .hero-layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(500px, 1.1fr);
    }

    .trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) and (max-width: 1099px) {
    .ready-panel {
      padding: 1rem;
    }

    .ready-panel-content > strong {
      font-size: 1.5rem;
    }

    .ready-panel-content p {
      font-size: 0.8rem;
    }

    .launch-action {
      gap: 0.4rem;
      padding-inline: 0.7rem;
      font-size: 0.75rem;
      white-space: nowrap;
    }
  }

  @media (max-width: 979px) {
    .hero {
      min-height: auto;
    }

    .hero-copy {
      max-width: 44rem;
    }
  }

  @media (max-width: 620px) {
    .hero {
      padding-top: 5rem;
    }

    .announcement {
      align-items: flex-start;
    }

    .announcement-arrow {
      display: none;
    }

    h1 {
      font-size: clamp(2.85rem, 14vw, 4.25rem);
    }

    .actions {
      display: grid;
    }

    .button {
      width: 100%;
    }

    .trust {
      grid-template-columns: 1fr;
    }

    .hero-visual :global(.portal-frame) {
      min-height: 610px;
      aspect-ratio: auto;
    }

    .launch-crossing {
      min-height: 610px;
      grid-template-columns: 1fr;
      gap: 1rem;
      justify-items: center;
    }

    .source-game {
      width: min(100%, 180px);
    }

    .source-art {
      width: 118px;
    }

    .portal-mark {
      width: 76px;
    }

    .ready-panel {
      width: 100%;
    }

    .visual-footer {
      display: grid;
    }

    .visual-link {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-arrow,
    .button,
    .source-game,
    .source-art,
    .source-label,
    .source-game > strong,
    .portal-mark,
    .ready-panel-content,
    .hero-visual :global(.portal-frame) {
      animation: none;
      transition: none;
    }

    .source-game,
    .source-art,
    .source-label,
    .source-game > strong,
    .portal-mark,
    .ready-panel-content {
      clip-path: none;
      filter: none;
      opacity: 1;
      transform: none;
    }

    .hero-visual :global(.portal-frame) {
      --portal-energy: 0;
    }

    .announcement:hover .announcement-arrow,
    .announcement:focus-visible .announcement-arrow,
    .button:hover {
      transform: none;
    }
  }
</style>
