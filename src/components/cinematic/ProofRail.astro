---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

type ProofGame = {
  slug: string;
  title: string;
  appid: number | null;
  tier: 'verified' | 'playable' | 'needs-attention' | 'unsupported';
};

const catalogue = JSON.parse(
  readFileSync(join(process.cwd(), 'public/catalogue-grid.json'), 'utf8'),
) as ProofGame[];
const eligible = catalogue.filter(
  (game) => (game.tier === 'verified' || game.tier === 'playable') && typeof game.appid === 'number',
);
const palworld = eligible.find((game) => game.appid === 1623730);
const runs = [palworld, ...eligible.filter((game) => game.appid !== 1623730)]
  .filter((game): game is ProofGame => Boolean(game))
  .slice(0, 4);
const counts = catalogue.reduce<Record<string, number>>((result, game) => {
  result[game.tier] = (result[game.tier] ?? 0) + 1;
  return result;
}, {});
const fmt = (value: number) => value.toLocaleString('en-US');
const API = 'https://mgp-api.macgameport.workers.dev/v1/stats';
const cover = (appid: number) =>
  'https://cdn.cloudflare.steamstatic.com/steam/apps/' + appid + '/library_600x900.jpg';
const fallback = (appid: number) =>
  'https://cdn.cloudflare.steamstatic.com/steam/apps/' + appid + '/header.jpg';
const tierLabel = (tier: string) => tier === 'verified' ? 'Verified' : 'Playable';
---

<section class="proof" aria-labelledby="proof-title" data-proof>
  <div class="wrap">
    <div class="proof-heading">
      <h2 id="proof-title">Running on Mac right now.</h2>
      <p>
        Compatibility grades come from actual launch evidence, with a clear result before you
        install. These are real entries from the Pixel Port catalogue.
      </p>
    </div>

    <dl class="stats" aria-label="Pixel Port by the numbers">
      <div>
        <dt>Games graded</dt>
        <dd>{fmt(catalogue.length)}</dd>
      </div>
      <div>
        <dt>Mac gamers</dt>
        <dd data-stat="users" aria-live="polite">1,000+</dd>
      </div>
      <div>
        <dt>Games launched</dt>
        <dd data-stat="launches" aria-live="polite">3,700+</dd>
      </div>
      <div>
        <dt>Setup</dt>
        <dd>One click</dd>
      </div>
    </dl>
    <p class="stats-status" data-stat-status aria-live="polite">Showing last published totals.</p>

    <ul class="game-grid" aria-label="Games proven to run on Mac">
      {
        runs.map((game, index) => (
          <li class:list={{ 'game-item': true, 'game-item--handoff': index === 0 }}>
            <a href={'/games/' + game.slug} class="game-card">
              <span class="cover">
                <span class="cover-fallback">{game.title}</span>
                <img
                  src={cover(game.appid as number)}
                  data-fallback={fallback(game.appid as number)}
                  alt=""
                  width="240"
                  height="360"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span class={'tier tier--' + game.tier}>
                  <span aria-hidden="true">{game.tier === 'verified' ? '✓' : '◐'}</span>
                  {tierLabel(game.tier)}
                </span>
              </span>
              <strong>{game.title}</strong>
              <span class="game-link">View compatibility <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="grade-note">
      {fmt(counts.verified ?? 0)} verified end to end and {fmt(counts.playable ?? 0)} graded playable.
      <a href="/games">Browse the full compatibility catalogue</a>
    </p>
  </div>
</section>

<script>
  for (const img of document.querySelectorAll<HTMLImageElement>('[data-proof] .cover img[data-fallback]')) {
    img.addEventListener('error', () => {
      const next = img.dataset.fallback;
      if (next) {
        img.dataset.fallback = '';
        img.src = next;
      } else {
        img.remove();
      }
    });
  }
</script>

<script is:inline define:vars={{ API }}>
  (() => {
    const section = document.querySelector('[data-proof]');
    if (!section) return;
    const stats = [...section.querySelectorAll('[data-stat]')];
    const status = section.querySelector('[data-stat-status]');
    if (!stats.length) return;
    let requested = false;
    const load = async () => {
      if (requested) return;
      requested = true;
      try {
        const response = await fetch(API, { cache: 'no-store' });
        if (!response.ok) return;
        const value = await response.json();
        let updated = false;
        for (const stat of stats) {
          const exact = value[stat.dataset.stat];
          if (typeof exact === 'number' && exact > 0) {
            stat.textContent = exact.toLocaleString('en-US');
            stat.title = 'Live total';
            updated = true;
          }
        }
        if (updated && status) status.textContent = 'Updated from live launch data.';
      } catch {}
    };
    if (!('IntersectionObserver' in window)) {
      load();
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        observer.disconnect();
        load();
      }
    }, { rootMargin: '240px 0px' });
    observer.observe(section);
  })();
</script>

<style>
  .proof {
    padding-block: clamp(4.75rem, 8vw, 7.5rem);
    border-block: 1px solid var(--color-line);
    background: #080614;
  }

  .proof-heading {
    display: grid;
    gap: 1.25rem;
    align-items: end;
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    color: var(--color-fg);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }

  .proof-heading p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    border-block: 1px solid var(--color-line);
  }

  .stats div {
    min-width: 0;
    padding: 1.15rem 0;
  }

  .stats div:nth-child(odd) {
    padding-right: 1rem;
  }

  .stats div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--color-line);
  }

  .stats dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .stats dd {
    margin: 0.22rem 0 0;
    color: var(--color-fg);
    font-size: clamp(1.65rem, 4vw, 2.8rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stats-status {
    margin: 0.7rem 0 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 2vw, 1.25rem);
    margin: clamp(2.5rem, 5vw, 4.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .game-grid li,
  .game-card {
    min-width: 0;
  }

  .game-item--handoff {
    position: relative;
    z-index: 1;
  }

  .game-card {
    display: block;
    color: var(--color-fg);
    text-decoration: none;
  }

  .cover {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: linear-gradient(145deg, #5c40b0, #228c86);
  }

  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1), filter 180ms ease;
  }

  .game-card:hover img,
  .game-card:focus-visible img {
    filter: brightness(1.07);
    transform: scale(1.025);
  }

  .cover-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    font-weight: 700;
    text-align: center;
  }

  .tier {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.4rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: #090717;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tier--verified {
    color: var(--color-verified);
  }

  .tier--playable {
    color: var(--color-playable);
  }

  .game-card > strong {
    display: block;
    overflow: hidden;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .game-link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.3rem;
    color: var(--color-accent-2);
    font-size: 0.75rem;
  }

  .game-link span {
    transition: transform 180ms ease;
  }

  .game-card:hover .game-link span,
  .game-card:focus-visible .game-link span {
    transform: translateX(3px);
  }

  .grade-note {
    max-width: 52rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .grade-note a {
    margin-left: 0.35rem;
    color: var(--color-accent-2);
    text-underline-offset: 3px;
  }

  @media (min-width: 760px) {
    .proof-heading {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
    }

    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stats div {
      padding: 1.3rem clamp(1rem, 2.5vw, 1.75rem);
      border-left: 1px solid var(--color-line);
    }

    .stats div:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .stats div:last-child {
      padding-right: 0;
    }

    .game-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 759px) {
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }
  }

  @supports (animation-timeline: view()) and (animation-range: entry 0% entry 80%) {
    @media (prefers-reduced-motion: no-preference) {
      .game-grid {
        view-timeline-name: --proof-grid;
        view-timeline-axis: block;
      }

      .game-item--handoff .cover {
        transform-origin: 50% 14%;
        animation: proof-cover-arrival 1ms linear both;
        animation-timeline: --proof-grid;
        animation-range: entry 0% entry 80%;
      }

      .game-item--handoff .cover img {
        animation: proof-art-settle 1ms linear both;
        animation-timeline: --proof-grid;
        animation-range: entry 0% entry 80%;
      }

      @keyframes proof-cover-arrival {
        0% {
          clip-path: inset(0 0 14% 0 round 12px);
          filter: saturate(0.78) brightness(0.86);
          transform: translate3d(0, -2rem, 0) scale(0.94) rotate(0.8deg);
        }

        72% {
          clip-path: inset(0 round 12px);
          filter: saturate(1.04) brightness(1.03);
          transform: translate3d(0, 0.2rem, 0) scale(1.01) rotate(-0.15deg);
        }

        100% {
          clip-path: inset(0 round 12px);
          filter: none;
          transform: none;
        }
      }

      @keyframes proof-art-settle {
        0% {
          transform: scale(1.06) translateY(-1%);
        }

        100% {
          transform: none;
        }
      }
    }
  }

  @media (max-width: 759px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (animation-range: entry 0% entry 80%) {
      .game-item--handoff .cover {
        animation-name: proof-cover-arrival-mobile;
      }

      @keyframes proof-cover-arrival-mobile {
        0% {
          clip-path: inset(0 0 10% 0 round 12px);
          filter: saturate(0.84) brightness(0.9);
          transform: translate3d(0, -1rem, 0) scale(0.97);
        }

        100% {
          clip-path: inset(0 round 12px);
          filter: none;
          transform: none;
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-item--handoff .cover,
    .game-item--handoff .cover img {
      animation: none;
      clip-path: none;
      filter: none;
      transform: none;
    }

    .cover img,
    .game-link span {
      transition: none;
    }

    .game-card:hover img,
    .game-card:focus-visible img,
    .game-card:hover .game-link span,
    .game-card:focus-visible .game-link span {
      transform: none;
    }
  }
</style>
