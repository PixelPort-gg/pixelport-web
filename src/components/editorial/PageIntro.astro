---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const titleId = `page-title-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
const pixels = Array.from({ length: 24 });
---

<section class="page-intro" aria-labelledby={titleId}>
  <div class="intro-inner">
    <div class="intro-layout">
      <div class="intro-copy">
        <h1 id={titleId}>{title}</h1>
        <p>{description}</p>
        <slot name="actions" />
        <slot name="meta" />
      </div>

      <div class="pixel-signal" aria-hidden="true">
        <div class="signal-glow"></div>
        <div class="pixel-grid">
          {pixels.map((_, i) => <span class:list={['pixel', `pixel-${i + 1}`]}></span>)}
        </div>
        <span class="signal-axis"></span>
        <span class="signal-caption">PIXEL / PORT</span>
      </div>
    </div>
  </div>
</section>

<style>
  .page-intro {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--color-line);
  }

  .page-intro::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, transparent 0 67%, rgba(255, 255, 255, 0.025) 67% 67.08%, transparent 67.08%),
      radial-gradient(42rem 24rem at 80% 20%, rgba(146, 104, 255, 0.12), transparent 68%);
    content: '';
    pointer-events: none;
  }

  .intro-inner {
    width: min(72rem, calc(100% - 3rem));
    margin-inline: auto;
    padding-block: clamp(5rem, 10vw, 8.5rem) clamp(4.25rem, 8vw, 7rem);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.55fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .intro-copy {
    max-width: 49rem;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--color-fg);
    font-size: clamp(3.25rem, 8vw, 6.9rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 0.88;
    text-wrap: balance;
  }

  .intro-copy > p {
    max-width: 42rem;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .pixel-signal {
    position: relative;
    min-height: 17rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    background:
      linear-gradient(145deg, rgba(31, 24, 56, 0.55), rgba(10, 8, 22, 0.2)),
      repeating-linear-gradient(0deg, transparent 0 20px, rgba(255, 255, 255, 0.025) 20px 21px),
      repeating-linear-gradient(90deg, transparent 0 20px, rgba(255, 255, 255, 0.025) 20px 21px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .signal-glow {
    position: absolute;
    top: 12%;
    bottom: 12%;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--color-accent), var(--color-accent-2), transparent);
    box-shadow:
      0 0 2rem rgba(146, 104, 255, 0.7),
      0 0 4rem rgba(63, 214, 206, 0.25);
  }

  .pixel-grid {
    position: absolute;
    inset: 2.15rem;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 0.32rem;
    opacity: 0.86;
  }

  .pixel {
    border: 1px solid rgba(255, 255, 255, 0.035);
    background: rgba(255, 255, 255, 0.02);
  }

  .pixel-3,
  .pixel-4,
  .pixel-9,
  .pixel-10,
  .pixel-15,
  .pixel-16,
  .pixel-21,
  .pixel-22 {
    border-color: rgba(146, 104, 255, 0.12);
    background: linear-gradient(135deg, rgba(146, 104, 255, 0.24), rgba(63, 214, 206, 0.12));
  }

  .pixel-5,
  .pixel-11,
  .pixel-17 {
    background: rgba(63, 214, 206, 0.12);
  }

  .signal-axis {
    position: absolute;
    top: 50%;
    right: 1.25rem;
    left: 1.25rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  }

  .signal-caption {
    position: absolute;
    right: 1rem;
    bottom: 0.8rem;
    color: color-mix(in srgb, var(--color-muted) 68%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
  }

  @media (max-width: 48rem) {
    .intro-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .pixel-signal {
      min-height: 9rem;
    }

    .pixel-grid {
      inset: 1.25rem;
    }
  }

  @media (max-width: 30rem) {
    .intro-inner {
      width: min(100% - 2rem, 72rem);
      padding-top: 4.25rem;
    }

    h1 {
      font-size: clamp(2.85rem, 16vw, 4.3rem);
    }
  }
</style>
