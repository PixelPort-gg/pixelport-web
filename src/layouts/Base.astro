---
import '@fontsource-variable/geologica/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL for og:image; defaults to the brand mark. */
  ogImage?: string;
  /** Extra <head> content (e.g. JSON-LD) passed via the "head" slot. */
}
const {
  title,
  description = 'Play Windows games on your Mac, honestly. Fast, native-feeling, and built for Apple Silicon.',
  ogImage,
} = Astro.props;
const fullTitle = title === 'Pixel Port' ? title : `${title} · Pixel Port`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pixel Port" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage ?? new URL('/brand/mark.svg', Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0816" />
    <meta name="application-name" content="Pixel Port" />
    <meta name="apple-mobile-web-app-title" content="Pixel Port" />
    <!-- Brand-entity structured data: tells Google "Pixel Port" is a named app/organization at this
         domain — the entity signal that drives brand-term ranking + sitelinks for a new domain. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://pixelport.gg/#org",
          "name": "Pixel Port",
          "url": "https://pixelport.gg/",
          "logo": "https://pixelport.gg/brand/mark.svg",
          "sameAs": ["https://discord.gg/2eQah8DjK6"]
        },
        {
          "@type": "WebSite",
          "@id": "https://pixelport.gg/#website",
          "name": "Pixel Port",
          "url": "https://pixelport.gg/",
          "publisher": { "@id": "https://pixelport.gg/#org" }
        },
        {
          "@type": "SoftwareApplication",
          "name": "Pixel Port",
          "operatingSystem": "macOS",
          "applicationCategory": "GameApplication",
          "url": "https://pixelport.gg/",
          "downloadUrl": "https://pixelport.gg/download",
          "description": "Pixel Port downloads, configures, and launches Windows games on your Mac automatically. Built for Apple Silicon."
        }
      ]
    })} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1"><slot /></main>
    <Footer />
    <script>
      // Referral attribution. Runs on EVERY page (this layout wraps the whole
      // site), so a ?ref=<token> is captured wherever a posted link lands —
      // compat pages, homepage, or /download. No cookies, no identifiers — just
      // the ref token. Must never affect the download UX.
      //
      // Two beacons make a funnel: a 'land' beacon fires the moment a ?ref=
      // arrives (so a visitor attributes even if they never download), and a
      // 'download' beacon still fires on the download CTA click. Both POST the
      // same 202 contract; `event` is extra and currently IGNORED by the server
      // (server only reads {ref, path}) — it's forward-compatible for when an
      // `event` column is added to web_refs. Ref policy is LATEST-WINS so a
      // fresh campaign click updates attribution.
      const WEBREF = 'https://mgp-api.macgameport.workers.dev/v1/webref';
      // Mirror the server's validation: alphanumeric + - / _, max 32 chars.
      const REF_RE = /^[a-z0-9_-]{1,32}$/i;
      function beacon(ref: string, event: 'land' | 'download') {
        try {
          fetch(WEBREF, {
            method: 'POST',
            mode: 'no-cors',
            keepalive: true,
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ ref, path: location.pathname, event }),
          }).catch(() => {});
        } catch {}
      }
      // 1) Capture ?ref= on load. Latest-wins; fire a landing beacon on first
      //    capture or when the campaign changed.
      try {
        const raw = new URLSearchParams(location.search).get('ref');
        const ref = raw && REF_RE.test(raw) ? raw : null;
        if (ref) {
          let prev = null;
          try { prev = localStorage.getItem('pp_ref'); } catch {}
          try {
            localStorage.setItem('pp_ref', ref);
            localStorage.setItem('pp_ref_ts', String(Date.now()));
          } catch {}
          if (ref !== prev) beacon(ref, 'land');
        }
      } catch {}
      // 2) Download CTA click — attribute the conversion with the stored ref.
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href^="/download"]');
        if (!a) return;
        let ref = 'direct';
        try {
          const stored = localStorage.getItem('pp_ref');
          if (stored && REF_RE.test(stored)) ref = stored;
        } catch {}
        beacon(ref, 'download');
      });
    </script>
  </body>
</html>
