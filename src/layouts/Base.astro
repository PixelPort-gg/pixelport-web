---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Extra <head> content (e.g. JSON-LD) passed via the "head" slot. */
}
const {
  title,
  description = 'Play Windows games on your Mac, honestly. Fast, native-feeling, free to try in beta.',
} = Astro.props;
const fullTitle = title === 'Pixel Port' ? title : `${title} · Pixel Port`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pixel Port" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/brand/mark.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0816" />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden">
    <Header />
    <main class="flex-1"><slot /></main>
    <Footer />
    <script>
      // Referral attribution: remember ?ref=<token> (first touch wins) and fire a
      // best-effort beacon when the download CTA is clicked. No cookies, no
      // identifiers — just the ref token. Must never affect the download UX.
      try {
        const ref = new URLSearchParams(location.search).get('ref');
        if (ref && !localStorage.getItem('pp_ref')) localStorage.setItem('pp_ref', ref);
      } catch {}
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href^="/download"]');
        if (!a) return;
        try {
          let ref = 'direct';
          try { ref = localStorage.getItem('pp_ref') || 'direct'; } catch {}
          fetch('https://mgp-api.macgameport.workers.dev/v1/webref', {
            method: 'POST',
            mode: 'no-cors',
            keepalive: true,
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ ref, path: location.pathname }),
          }).catch(() => {});
        } catch {}
      });
    </script>
  </body>
</html>
