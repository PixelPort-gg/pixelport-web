---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  // Newer/older neighbours give every post inbound links from real pages, not
  // only from the index card.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const canonical = new URL(`/blog/${post.id}/`, Astro.site).toString();
const published = post.data.date.toISOString();
const modified = (post.data.updated ?? post.data.date).toISOString();
const image = post.data.image ?? new URL('/og.png', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  dateModified: modified,
  url: canonical,
  mainEntityOfPage: canonical,
  image,
  author: { '@type': 'Organization', name: 'Pixel Port', url: 'https://pixelport.gg/' },
  publisher: { '@id': 'https://pixelport.gg/#org' },
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={image}
  publishedTime={published}
  modifiedTime={modified}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <header class="relative overflow-hidden border-b border-line">
    <div class="pixel-field absolute inset-0 opacity-30 [mask-image:linear-gradient(to_bottom,#000,transparent)]" aria-hidden="true"></div>
    <div class="absolute left-[12%] top-0 h-64 w-64 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative py-16 sm:py-24">
      <a href="/blog/" class="inline-flex min-h-11 items-center gap-2 text-sm text-muted transition-colors hover:text-fg">
        <span aria-hidden="true">&larr;</span> All updates
      </a>
      <time class="mt-12 block text-sm text-muted" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      <h1 class="mt-4 max-w-5xl text-balance text-4xl font-semibold leading-[0.98] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
        {post.data.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{post.data.description}</p>
    </div>
  </header>

  <article class="wrap py-14 lg:py-20">
    <div class="prose prose-invert prose-lg mx-auto max-w-3xl prose-headings:tracking-tight prose-a:text-accent-2 prose-strong:text-fg">
      <Content />
    </div>
    <nav class="mx-auto mt-14 max-w-3xl border-t border-line pt-8 text-sm" aria-label="More updates">
      <ul class="grid gap-3 sm:grid-cols-2">
        {newer && (
          <li>
            <span class="block text-muted">Newer</span>
            <a href={`/blog/${newer.id}/`} class="text-accent-2 hover:underline">{newer.data.title}</a>
          </li>
        )}
        {older && (
          <li class="sm:text-right">
            <span class="block text-muted">Older</span>
            <a href={`/blog/${older.id}/`} class="text-accent-2 hover:underline">{older.data.title}</a>
          </li>
        )}
      </ul>
      <p class="mt-6 text-muted">
        Browse <a href="/games/verified/" class="text-accent-2 hover:underline">every game verified on Mac</a> or
        check <a href="/mac/" class="text-accent-2 hover:underline">whether yours runs</a>.
      </p>
    </nav>
  </article>
</Base>
