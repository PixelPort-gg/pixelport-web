---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/editorial/PageIntro.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Blog" description="Updates from the Pixel Port team.">
  <PageIntro
    title="Updates"
    description="Notes from the Pixel Port team: releases, engineering, and what runs on Mac now."
  />

  <section class="journal" aria-labelledby="journal-title">
    <div class="journal-heading">
      <h2 id="journal-title">Latest updates</h2>
      <p>{posts.length} published {posts.length === 1 ? 'note' : 'notes'}, newest first.</p>
    </div>

    <ol class="post-list">
      {
        posts.map((post, index) => (
          <li>
            <a href={`/blog/${post.id}`} class:list={['post-entry', { lead: index === 0 }]}>
              <div class="entry-copy">
                <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="entry-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <style>
    .journal {
      width: min(64rem, calc(100% - 3rem));
      margin-inline: auto;
      padding-block: clamp(4.5rem, 9vw, 8rem) 2rem;
    }

    .journal-heading {
      margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    }

    .journal-heading h2 {
      margin: 0;
      color: var(--color-fg);
      font-size: clamp(1.6rem, 3.5vw, 2.6rem);
      font-weight: 620;
      letter-spacing: -0.045em;
    }

    .journal-heading p {
      margin: 0.65rem 0 0;
      color: var(--color-muted);
      font-size: 0.875rem;
    }

    .post-list {
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--color-line);
      list-style: none;
    }

    .post-entry {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 2.75rem;
      gap: clamp(1rem, 4vw, 3rem);
      align-items: start;
      padding-block: clamp(1.65rem, 4vw, 2.75rem);
      border-bottom: 1px solid var(--color-line);
      color: inherit;
      text-decoration: none;
    }

    .entry-copy time {
      display: block;
      color: var(--color-muted);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .entry-copy h3 {
      max-width: 28ch;
      margin: 0.6rem 0 0;
      color: var(--color-fg);
      font-size: clamp(1.2rem, 2.5vw, 1.65rem);
      font-weight: 620;
      letter-spacing: -0.035em;
      line-height: 1.18;
      text-wrap: balance;
      transition: color 160ms ease;
    }

    .lead .entry-copy h3 {
      font-size: clamp(1.45rem, 3vw, 2.1rem);
    }

    .entry-copy p {
      max-width: 44rem;
      margin: 0.7rem 0 0;
      color: var(--color-muted);
      font-size: 0.925rem;
      line-height: 1.65;
      text-wrap: pretty;
    }

    .entry-arrow {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      border: 1px solid var(--color-line);
      border-radius: 50%;
      color: var(--color-muted);
      transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
    }

    .post-entry:hover .entry-copy h3 {
      color: var(--color-accent-2);
    }

    .post-entry:hover .entry-arrow {
      border-color: color-mix(in srgb, var(--color-accent-2) 45%, transparent);
      color: var(--color-accent-2);
      transform: translate(0.12rem, -0.12rem);
    }

    @media (max-width: 42rem) {
      .journal {
        width: min(100% - 2rem, 64rem);
      }

      .journal-heading {
        margin-bottom: 2.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .entry-copy h3,
      .entry-arrow {
        transition: none;
      }

      .post-entry:hover .entry-arrow {
        transform: none;
      }
    }
  </style>
</Base>
