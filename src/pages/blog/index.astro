---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Blog" description="Updates from the Pixel Port team.">
  <section class="wrap py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Updates</h1>
    <ul class="mt-10 divide-y divide-line">
      {
        posts.map((p) => (
          <li class="py-6">
            <a href={`/blog/${p.id}`} class="group block">
              <p class="text-sm text-muted">{fmt(p.data.date)}</p>
              <h2 class="mt-1 text-xl font-semibold text-fg group-hover:text-accent-2">
                {p.data.title}
              </h2>
              <p class="mt-1 text-fg/80">{p.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
