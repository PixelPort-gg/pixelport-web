---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Base title={doc.data.title} description={doc.data.description}>
  <header class="relative overflow-hidden border-b border-line">
    <div class="pixel-field absolute inset-0 opacity-25 [mask-image:linear-gradient(to_bottom,#000,transparent)]" aria-hidden="true"></div>
    <div class="absolute right-[12%] top-8 h-56 w-56 rounded-full bg-accent-2/10 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative py-16 sm:py-24">
      <a href="/docs" class="inline-flex min-h-11 items-center gap-2 text-sm text-muted transition-colors hover:text-fg">
        <span aria-hidden="true">&larr;</span> All docs
      </a>
      <h1 class="mt-12 max-w-5xl text-balance text-4xl font-semibold leading-[0.98] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
        {doc.data.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{doc.data.description}</p>
    </div>
  </header>

  <article class="wrap py-14 lg:py-20">
    <div class="prose prose-invert prose-lg mx-auto max-w-3xl prose-headings:tracking-tight prose-a:text-accent-2 prose-strong:text-fg">
      <Content />
    </div>
  </article>
</Base>
