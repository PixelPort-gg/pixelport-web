---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Docs" description="How Pixel Port works: Prism, the Synthesis Engine, the Distributed Validation Network, and our honest compatibility tiers.">
  <section class="wrap py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Docs</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">How the runtime, the Synthesis Engine, and our honest compatibility tiers work.</p>
    <ul class="mt-10 space-y-3">
      {
        docs.map((d) => (
          <li>
            <a
              href={`/docs/${d.id}`}
              class="block rounded-xl border border-line bg-surface/50 p-5 transition-colors hover:border-accent/40 hover:bg-surface"
            >
              <h2 class="font-semibold text-fg">{d.data.title}</h2>
              {d.data.description && <p class="mt-1 text-sm text-muted">{d.data.description}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
