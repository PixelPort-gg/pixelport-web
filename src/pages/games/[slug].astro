---
import Base from '../../layouts/Base.astro';
import games from '../../data/games.json';
import catalogue from '../../data/catalogue.json';
import { tierMeta, coverUrl, coverFallbackUrl, engineLabel, prettyAC, generate, type Tier } from '../../lib/catalog';

// Seeded "you can play these" recommendations — curated games that genuinely run,
// rotated deterministically by slug so different pages surface different trios.
const pool = games.filter((g) => (g.tier === 'verified' || g.tier === 'playable') && g.appid);
function seededPicks(slug: string) {
  const seed = [...slug].reduce((a, c) => a + c.charCodeAt(0), 0);
  return [0, 1, 2].map((i) => pool[(seed + i) % pool.length]);
}

export function getStaticPaths() {
  return [
    ...games.map((g) => ({ params: { slug: g.slug }, props: { game: { ...g, _cat: false } } })),
    ...catalogue.map((e) => ({ params: { slug: e.slug }, props: { game: generate(e) } })),
  ];
}

const { game } = Astro.props as { game: any };
const meta = tierMeta[game.tier as Tier];
const cover = coverUrl(game.appid);
const fb = coverFallbackUrl(game.appid);
const isBlocked = game.tier === 'unsupported';
const picks = seededPicks(game.slug);

// Quick-facts row adapts to what we know about the game.
const facts: [string, string][] = game._cat
  ? ([
      ['Engine', engineLabel(game.engine)],
      ['Graphics', game.graphics ? String(game.graphics).toUpperCase() : null],
      ['Anti-cheat', prettyAC(game.antiCheat)],
    ].filter(([, v]) => v) as [string, string][])
  : ([['Genre', game.genre], game.lastTested ? ['Last tested', game.lastTested] : null].filter(
      Boolean,
    ) as [string, string][]);

const h1 = isBlocked ? `Can you play ${game.title} on Mac?` : `How to play ${game.title} on Mac`;
const seoTitle = isBlocked
  ? `Can You Play ${game.title} on Mac? The Honest Answer`
  : `Play ${game.title} on Mac, Free and One-Click (Apple Silicon)`;
const description = isBlocked
  ? `${game.summary} Here is exactly what blocks it and who it is up to.`
  : `Play ${game.title} on your Mac in one click. No Windows, no Boot Camp, no setup. Free, runs on Apple Silicon (M1 to M4) through Pixel Port.`;

const canonical = new URL(`/games/${game.slug}`, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      name: game.title,
      ...(game.genre ? { genre: game.genre } : {}),
      gamePlatform: 'macOS (Apple Silicon)',
      operatingSystem: 'macOS 14+',
      url: canonical,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Games', item: new URL('/games', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: game.title, item: canonical },
      ],
    },
  ],
};
---

<Base title={seoTitle} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <article class="wrap py-16">
    <a href="/games" class="text-sm text-muted hover:text-fg">&larr; All games</a>

    <header class="mt-6 flex flex-col gap-7 sm:flex-row sm:items-start">
      <div class="w-36 shrink-0 sm:w-44">
        <div class="relative aspect-[2/3] overflow-hidden rounded-xl border border-line bg-linear-to-br from-[#5C40B0] to-[#228C86] shadow-[var(--shadow-glow)]">
          <span class="absolute inset-0 flex items-center justify-center p-3 text-center text-sm font-semibold text-white/95">
            {game.title}
          </span>
          {
            cover && (
              <img
                src={cover}
                data-fb={fb}
                alt={`${game.title} cover art`}
                class="absolute inset-0 h-full w-full object-cover"
                onerror="if(this.dataset.fb){this.src=this.dataset.fb;this.dataset.fb='';}else{this.remove();}"
              />
            )
          }
        </div>
      </div>

      <div class="min-w-0">
        <span class={`inline-block rounded-full px-3 py-1 text-sm font-semibold ring-1 ${meta.badge}`}>
          {meta.label}{!isBlocked ? ' on Mac' : ''}
        </span>
        <h1 class="mt-3 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">{h1}</h1>
        <p class="mt-4 max-w-2xl text-lg text-muted">{game.summary}</p>
      </div>
    </header>

    {
      isBlocked ? (
        <div class="mt-12 max-w-2xl space-y-6">
          <div class="rounded-2xl border border-blocked/30 bg-blocked/10 p-6">
            <h2 class="font-semibold text-blocked">What blocks it</h2>
            <p class="mt-2 text-fg/85">
              {game.title} uses {game.blocker.antiCheat}. Anti-cheat like this needs to run deep in the
              system, and that access is not available to a compatibility layer on macOS. This is not a
              graphics or performance limit, and it is not something Pixel Port can work around.
            </p>
          </div>

          <div class="rounded-2xl border border-line bg-surface/50 p-6">
            <h2 class="font-semibold text-fg">Who this is up to</h2>
            <p class="mt-1 text-sm font-medium text-accent-2">{game.blocker.whoDecides}</p>
            <p class="mt-3 text-fg/85">{game.blocker.status}</p>
          </div>

          <div class="rounded-2xl border border-line bg-surface/50 p-6">
            <h2 class="font-semibold text-fg">You can play these on Mac</h2>
            <ul class="mt-4 grid grid-cols-3 gap-3">
              {picks.map((p) => (
                <li>
                  <a href={`/games/${p.slug}`} class="lift group block">
                    <div class="relative aspect-[2/3] overflow-hidden rounded-lg border border-line bg-linear-to-br from-[#5C40B0] to-[#228C86]">
                      <span class="absolute inset-0 flex items-center justify-center p-2 text-center text-[11px] font-semibold text-white/95">
                        {p.title}
                      </span>
                      {coverUrl(p.appid) && (
                        <img
                          src={coverUrl(p.appid)}
                          data-fb={coverFallbackUrl(p.appid)}
                          alt={`${p.title} cover art`}
                          loading="lazy"
                          class="lift-img absolute inset-0 h-full w-full object-cover"
                          onerror="if(this.dataset.fb){this.src=this.dataset.fb;this.dataset.fb='';}else{this.remove();}"
                        />
                      )}
                    </div>
                    <p class="mt-2 truncate text-xs font-medium text-fg group-hover:text-accent-2">{p.title}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <a href="/games" class="inline-block text-sm font-medium text-accent-2 hover:underline">
            Browse the full catalogue and what runs on Mac &rarr;
          </a>
        </div>
      ) : (
        <Fragment>
          {facts.length > 0 && (
            <dl class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-3">
              {facts.map(([k, v]) => (
                <div class="rounded-xl border border-line bg-surface/50 p-4">
                  <dt class="text-xs uppercase tracking-wide text-muted">{k}</dt>
                  <dd class="mt-1 text-sm text-fg">{v}</dd>
                </div>
              ))}
            </dl>
          )}

          <section class="mt-12 max-w-2xl">
            <h2 class="text-2xl font-semibold">What you need</h2>
            <ul class="mt-4 space-y-2 text-fg/85">
              {game.requirements.map((r: string) => (
                <li class="flex gap-2">
                  <span class="text-accent-2">&bull;</span>
                  {r}
                </li>
              ))}
            </ul>
          </section>

          <section class="mt-12 max-w-2xl">
            <h2 class="text-2xl font-semibold">Step by step</h2>
            <ol class="mt-6 space-y-5">
              {game.steps.map((s: { title: string; body: string }, i: number) => (
                <li class="flex gap-4 rounded-2xl border border-line bg-surface/50 p-5">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-accent to-accent-2 text-sm font-bold text-white">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="font-semibold text-fg">{s.title}</h3>
                    <p class="mt-1 text-sm text-fg/80">{s.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <div class="mt-14 max-w-2xl rounded-2xl border border-accent/30 bg-accent/10 p-6">
            <p class="text-lg font-medium">Ready to play {game.title} on your Mac?</p>
            <a
              href="/download"
              class="mt-4 inline-block rounded-full bg-linear-to-r from-accent to-accent-2 px-6 py-3 font-semibold text-white shadow-[var(--shadow-glow)] [text-shadow:0_1px_2px_rgba(10,8,22,0.4)] transition-transform active:scale-[0.98]"
            >
              Download &amp; Play {game.title} Free
            </a>
          </div>
        </Fragment>
      )
    }
  </article>
</Base>
