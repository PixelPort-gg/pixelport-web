---
import Base from '../../layouts/Base.astro';
import games from '../../data/games.json';
import { tierMeta, coverUrl, coverFallbackUrl, type Tier } from '../../lib/catalog';

const order: Record<Tier, number> = { verified: 0, playable: 1, 'needs-attention': 2, unsupported: 3 };
const sorted = [...games].sort(
  (a, b) => order[a.tier as Tier] - order[b.tier as Tier] || a.title.localeCompare(b.title)
);

const filters: { key: string; label: string }[] = [
  { key: 'all', label: `All ${games.length}` },
  { key: 'verified', label: 'Verified' },
  { key: 'playable', label: 'Playable' },
  { key: 'needs-attention', label: 'Needs attention' },
  { key: 'unsupported', label: 'Unsupported' },
];

const seoTitle = 'Mac Game Compatibility: Which Windows Games Work on Mac';
const description =
  'Browse the Pixel Port catalogue of Windows games that run on Apple Silicon Macs, each with an honest compatibility tier. Free, one-click installs.';
---

<Base title={seoTitle} description={description}>
  <section class="wrap py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Which games work on Mac?</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Every game carries an honest compatibility tier earned from real launches on real Macs. No
      guesses, no overselling.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="tablist">
      {
        filters.map((f, i) => (
          <button
            data-filter={f.key}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-line bg-surface/50 px-4 py-1.5 text-sm text-muted transition-colors hover:text-fg aria-selected:border-transparent aria-selected:bg-accent aria-selected:text-white"
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <ul id="grid" class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      {
        sorted.map((g) => {
          const meta = tierMeta[g.tier as Tier];
          const cover = coverUrl(g.appid);
          const fb = coverFallbackUrl(g.appid);
          return (
            <li class="game-card" data-tier={g.tier}>
              <a href={`/games/${g.slug}`} class="lift group block">
                <div class="relative aspect-[2/3] overflow-hidden rounded-xl border border-line bg-linear-to-br from-[#5C40B0] to-[#228C86] shadow-[var(--shadow-glow)]">
                  <span class="absolute inset-0 flex items-center justify-center p-4 text-center text-base font-semibold text-white/95">
                    {g.title}
                  </span>
                  {cover && (
                    <img
                      src={cover}
                      data-fb={fb}
                      alt={`${g.title} cover art`}
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
                      onerror="if(this.dataset.fb){this.src=this.dataset.fb;this.dataset.fb='';}else{this.remove();}"
                    />
                  )}
                  <span
                    class={`absolute right-2 top-2 rounded-full px-2 py-0.5 text-[11px] font-semibold ring-1 backdrop-blur-md ${meta.badge}`}
                  >
                    {meta.label}
                  </span>
                </div>
                <h2 class="mt-2 truncate text-sm font-medium text-fg group-hover:text-accent-2">{g.title}</h2>
                <p class="truncate text-xs text-muted">{g.genre}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <script is:inline>
    const buttons = document.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('#grid .game-card');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = btn.getAttribute('data-filter');
        buttons.forEach((b) => b.setAttribute('aria-selected', b === btn ? 'true' : 'false'));
        cards.forEach((c) => {
          c.hidden = !(f === 'all' || c.getAttribute('data-tier') === f);
        });
      });
    });
  </script>
</Base>
