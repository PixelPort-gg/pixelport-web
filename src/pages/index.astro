---
import Base from '../layouts/Base.astro';
import games from '../data/games.json';

const featured = games.slice(0, 3);
const tierClass = (t: string) =>
  t === 'verified'
    ? 'text-verified bg-verified/15 ring-verified/30'
    : 'text-playable bg-playable/15 ring-playable/30';

const oldWays = [
  { name: 'Paid compatibility layer', cost: '~$50/yr + manual setup' },
  { name: 'A hand-built Wine bottle', cost: 'hours in the terminal' },
  { name: 'A virtual machine', cost: 'slow, melts your battery' },
  { name: 'Boot Camp', cost: "doesn't exist on Apple Silicon" },
];

const pillars = [
  {
    name: 'Prism',
    tag: 'the runtime',
    body: 'A free, modern runtime that translates a game’s DirectX calls straight to Metal on Apple Silicon. Most games never notice they left Windows. No licence, no bottle to babysit.',
  },
  {
    name: 'Synthesis Engine',
    tag: 'the brain',
    body: 'It reads each game and works out how it should run on your Mac: the graphics path, the dependencies, the launch plan, all worked out automatically. You click once; it does the thinking.',
  },
  {
    name: 'Distributed Validation Network',
    tag: 'the flywheel',
    body: 'Every launch makes Pixel Port smarter. When one Mac proves a game runs, it is proven for everyone. The catalogue gets more reliable the more people play.',
  },
];
---

<Base
  title="Play Windows Games on Mac in One Click"
  description="Pixel Port downloads, configures, and launches Windows games on your Mac automatically. Free, no Wine setup, no bottles, no VM. Built for Apple Silicon."
>
  <!-- Hero -->
  <section class="wrap grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <h1 class="text-balance text-5xl font-semibold leading-[1.04] tracking-tight sm:text-6xl lg:text-7xl">
        Game on Mac<br />with a single click.
      </h1>
      <p class="mt-6 max-w-xl text-balance text-lg text-muted sm:text-xl">
        Pixel Port runs Windows games on your Mac. One click downloads the game, configures
        everything, and launches it. No bottles, no VMs, no partitions, no terminal.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="/download"
          class="rounded-full bg-linear-to-r from-accent to-accent-2 px-7 py-3.5 font-semibold text-white shadow-xl shadow-black/30 transition-transform active:scale-[0.98]"
        >
          Download for Mac
        </a>
        <a href="/games" class="px-2 py-2 font-medium text-accent-2 hover:underline">
          See what runs &rarr;
        </a>
      </div>
      <p class="mt-4 text-sm text-muted">Free to start. Apple Silicon, macOS 14+. No account needed to browse.</p>
    </div>

    <div class="relative flex justify-center">
      <div class="absolute h-64 w-64 rounded-full bg-accent/25 blur-[90px]" aria-hidden="true"></div>
      <img
        src="/brand/mark.svg"
        alt="The Pixel Port pixel-P mark"
        width="400"
        height="400"
        class="relative w-[min(78%,380px)] drop-shadow-[0_24px_70px_rgba(146,104,255,0.35)]"
      />
    </div>
  </section>

  <!-- The problem: Mac gaming is hard -->
  <section class="wrap py-16">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Mac gaming was never this easy.</h2>
        <p class="mt-4 text-lg text-muted">
          Playing a Windows game on a Mac has always meant picking your poison. Every option costs
          you money, hours, battery, or all three. Most people just give up.
        </p>
        <p class="mt-4 text-lg text-fg/85">
          Pixel Port collapses all of it into a single click. The time it takes to get a game running
          used to be measured in hours. We are driving it toward seconds.
        </p>
      </div>

      <ul class="space-y-px overflow-hidden rounded-2xl border border-line">
        {
          oldWays.map((w) => (
            <li class="flex items-center justify-between gap-4 bg-surface/40 px-5 py-4">
              <span class="text-fg/70 line-through decoration-rose-400/50">{w.name}</span>
              <span class="text-right text-sm text-muted">{w.cost}</span>
            </li>
          ))
        }
        <li class="flex items-center justify-between gap-4 bg-linear-to-r from-accent/20 to-accent-2/15 px-5 py-5 ring-1 ring-accent/30">
          <span class="font-semibold text-fg">Pixel Port</span>
          <span class="text-right text-sm font-medium text-accent-2">one click</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- How it works: the infrastructure -->
  <section class="wrap py-16">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      One click on the surface. Real engineering underneath.
    </h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Three systems do the work so you do not have to.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        pillars.map((p, i) => (
          <div class="relative overflow-hidden rounded-2xl border border-line bg-surface/50 p-6">
            <div
              class="absolute -right-10 -top-10 h-32 w-32 rounded-full blur-2xl"
              style={`background: ${i === 1 ? 'rgba(63,214,206,0.18)' : 'rgba(146,104,255,0.18)'}`}
            />
            <p class="text-xs font-mono uppercase tracking-[0.18em] text-muted">{p.tag}</p>
            <h3 class="mt-2 text-xl font-semibold text-fg">{p.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-fg/80">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Honest tiers (trust, not the headline) -->
  <section class="wrap py-16">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">We are honest about what works.</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Every game is graded honestly, so you know exactly what you are getting before you install.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          ['Verified', 'A human confirmed it end-to-end on a real Mac.', 'text-verified'],
          ['Playable', 'Auto-tested or community-confirmed, not yet verified.', 'text-playable'],
          ['Needs attention', 'Runs with caveats or a known workaround.', 'text-orange-400'],
          ['Unsupported', 'A hard blocker, like kernel anti-cheat.', 'text-rose-400'],
        ].map(([t, d, c]) => (
          <div class="rounded-2xl border border-line bg-surface/50 p-5">
            <h3 class={`font-semibold ${c}`}>{t}</h3>
            <p class="mt-1 text-sm text-fg/80">{d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Featured games -->
  <section class="wrap py-16">
    <div class="flex items-end justify-between">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Play these on Mac</h2>
      <a href="/games" class="text-sm font-medium text-accent-2 hover:underline">All games &rarr;</a>
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        featured.map((g) => (
          <li>
            <a
              href={`/games/${g.slug}`}
              class="group block h-full rounded-2xl border border-line bg-surface/60 p-5 transition-colors hover:border-accent/40 hover:bg-surface"
            >
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold text-fg">{g.title}</h3>
                <span class={`shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold capitalize ring-1 ${tierClass(g.tier)}`}>
                  {g.tier}
                </span>
              </div>
              <p class="mt-3 text-sm text-fg/80">{g.summary}</p>
              <span class="mt-4 inline-block text-sm font-medium text-accent-2 group-hover:underline">
                How to play on Mac
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Download -->
  <section class="wrap py-20">
    <div class="overflow-hidden rounded-3xl border border-accent/25 bg-linear-to-br from-accent/15 to-accent-2/10 p-10 text-center sm:p-14">
      <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        Your Mac can play more than you think.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-muted">
        Download Pixel Port, pick a game, click once. That is the whole thing.
      </p>
      <a
        href="/download"
        class="mt-8 inline-block rounded-full bg-linear-to-r from-accent to-accent-2 px-8 py-4 text-lg font-semibold text-white shadow-xl shadow-black/30 transition-transform active:scale-[0.98]"
      >
        Download for Mac
      </a>
    </div>
  </section>
</Base>
