---
import Base from '../../layouts/Base.astro';
import snapshot from '../../data/compat.json';
import enabledAppids from '../../../scripts/enabled.json';
import nativeMacIds from '../../data/native-mac.json';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { compatMeta, pagePath, artChain, ART_ONERROR, type CompatGame, type CompatTier } from '../../lib/compat';

const ENABLED = new Set(enabledAppids as number[]);
const NATIVE_MAC = new Set(nativeMacIds as number[]);
const all = (snapshot as any).games as CompatGame[];
const order: CompatTier[] = ['verified', 'playable', 'untested', 'unsupported'];
const groups = order
  .map((tier) => ({ tier, meta: compatMeta[tier], games: all.filter((g) => g.tier === tier) }))
  .filter((g) => g.games.length > 0);

const sections: Record<CompatTier, { title: string; blurb: string }> = {
  verified: {
    title: 'Verified · runs on real Macs',
    blurb: 'A real Apple Silicon Mac ran each of these end to end through Pixel Port. No asterisks.',
  },
  playable: {
    title: 'Playable · community & template confidence',
    blurb: 'Graded playable from community reports and how each game is built; not yet hand-verified by us.',
  },
  untested: {
    title: 'Untested · try it and help',
    blurb: 'In the catalogue, but nobody has confirmed a full run yet. Your attempt grades it for everyone.',
  },
  unsupported: {
    title: 'Not supported · the honest no',
    blurb: 'Blocked on Mac (almost always kernel anti-cheat), and no tool can honestly work around it.',
  },
};

const fmt = (n: number) => n.toLocaleString('en-US');
const catalogueCount = (JSON.parse(
  readFileSync(join(process.cwd(), 'public/catalogue-grid.json'), 'utf8'),
) as unknown[]).length;
const seoTitle = 'Does It Run on Mac? Honest Game Compatibility for Apple Silicon';
const description = `${fmt(all.length)} Windows games with a straight answer for Apple Silicon Macs: verified, playable, untested, or an honest no. One-click installs through Pixel Port.`;
---

<Base title={seoTitle} description={description}>
  <header class="relative overflow-hidden border-b border-line">
    <div class="pixel-field absolute inset-0 opacity-35 [mask-image:linear-gradient(to_bottom,#000,transparent)]" aria-hidden="true"></div>
    <div class="absolute -right-20 top-8 h-80 w-80 rounded-full bg-accent-2/10 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative grid gap-10 py-16 sm:py-24 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <h1 class="max-w-4xl text-balance text-5xl font-semibold leading-[0.94] tracking-[-0.05em] sm:text-7xl">
          Does it run<br />on Mac?
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          Straight answers for Apple Silicon. Verified means a real Mac ran it end to end; when a game is
          blocked, we say so and tell you why. No fabricated green checkmarks.
        </p>
      </div>
      <div class="flex items-baseline gap-3 border-l border-accent/40 pl-5 lg:mb-2 lg:block">
        <p class="text-5xl font-semibold tabular-nums tracking-tight">{fmt(all.length)}</p>
        <p class="text-sm text-muted lg:mt-2">titles tracked</p>
      </div>
    </div>
  </header>

  <section class="wrap py-10 sm:py-14">
    <div class="glass-panel sticky top-20 z-30 rounded-2xl p-3 sm:flex sm:items-center sm:justify-between sm:gap-4">
      <label for="q" class="sr-only">Search Mac compatibility</label>
      <input
        id="q"
        type="search"
        placeholder={`Search ${fmt(all.length)} games…`}
        autocomplete="off"
        class="w-full rounded-xl border border-line bg-surface/70 px-5 py-3 text-sm text-fg placeholder:text-muted focus:border-accent/50 sm:max-w-md"
      />
      <a href="/games/" class="mt-3 hidden shrink-0 px-3 text-sm font-medium text-accent-2 hover:underline sm:mt-0 sm:block">
        Browse all {fmt(catalogueCount)} games &rarr;
      </a>
    </div>
    <p id="search-status" class="mt-4 font-mono text-xs uppercase tracking-[0.12em] text-muted" role="status">
      Showing all {fmt(all.length)} compatibility results.
    </p>
    <p id="none" hidden class="mt-6 text-sm text-muted">
      No matches here yet. The full catalogue is searchable on the <a href="/games/" class="text-accent-2 hover:underline">games page</a>.
    </p>

    {
      groups.map(({ tier, meta, games }) => (
        <section data-sec class="mt-16 border-t border-line pt-8 sm:mt-24 sm:pt-10">
          <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(16rem,28rem)] md:items-start">
            <h2 class="flex items-center gap-3 text-2xl font-semibold tracking-tight sm:text-3xl">
              <span class={`h-2.5 w-2.5 rounded-full ${meta.dot}`} aria-hidden="true" />
              {sections[tier].title}
            </h2>
            <div>
              <p class="text-sm leading-relaxed text-muted">{sections[tier].blurb}</p>
              <p class="mt-2 font-mono text-xs uppercase tracking-[0.16em] text-muted">
                <span data-tier-count data-total={games.length}>{fmt(games.length)}</span> games
              </p>
            </div>
          </div>
          <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-7 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            {games.map((g) => {
              const art = artChain(g.appid);
              return (
                <li data-n={g.name.toLowerCase()}>
                  <a href={pagePath(g)} class="group block">
                    <div class="relative aspect-[2/3] overflow-hidden rounded-xl border border-line bg-linear-to-br from-[#5C40B0] to-[#228C86] shadow-[0_24px_55px_-35px_rgba(146,104,255,0.9)]">
                      <span class="absolute inset-0 flex items-center justify-center p-3 text-center text-sm font-semibold text-white/95">
                        {g.name}
                      </span>
                      <img
                        src={art.src}
                        data-fb={art.fallbacks}
                        alt={`${g.name} cover art`}
                        loading="lazy"
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
                        onerror={ART_ONERROR}
                      />
                      <span
                        class={`absolute right-2 top-2 rounded-full px-2 py-0.5 text-[11px] font-semibold ring-1 backdrop-blur-md ${meta.badge}`}
                      >
                        {meta.label}
                      </span>
                      {tier === 'playable' && !ENABLED.has(g.appid) && !NATIVE_MAC.has(g.appid) && (
                        <span class="absolute bottom-2 left-2 rounded-full bg-base-top/90 px-2 py-1 text-[11px] font-semibold text-fg ring-1 ring-playable/50 backdrop-blur-md">
                          Needs beta enablement
                        </span>
                      )}
                    </div>
                    <p class="mt-2 truncate text-sm font-medium text-fg group-hover:text-accent-2">{g.name}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <p class="mt-20 max-w-2xl border-l border-accent-2/40 pl-4 text-sm leading-relaxed text-muted">
      Looking for something else? The <a href="/games/" class="text-accent-2 hover:underline">full catalogue</a> grades
      thousands more, and every verdict updates as real Macs report back.
    </p>
  </section>

  <script is:inline>
    // The only client JS on these pages: filter the statically rendered list.
    const q = document.getElementById('q');
    const items = [...document.querySelectorAll('[data-n]')];
    const secs = [...document.querySelectorAll('[data-sec]')];
    const none = document.getElementById('none');
    const status = document.getElementById('search-status');
    let t;
    q.addEventListener('input', () => {
      clearTimeout(t);
      t = setTimeout(() => {
        const v = q.value.trim().toLowerCase();
        items.forEach((li) => {
          const hit = !v || li.dataset.n.includes(v);
          li.hidden = !hit;
        });
        let visibleTotal = 0;
        secs.forEach((s) => {
          const visible = [...s.querySelectorAll('[data-n]')].filter((li) => !li.hidden).length;
          visibleTotal += visible;
          s.hidden = visible === 0;
          const count = s.querySelector('[data-tier-count]');
          if (count) count.textContent = visible.toLocaleString('en-US');
        });
        none.hidden = visibleTotal > 0;
        status.textContent = v
          ? `${visibleTotal.toLocaleString('en-US')} ${visibleTotal === 1 ? 'result' : 'results'} for “${q.value.trim()}”.`
          : `Showing all ${items.length.toLocaleString('en-US')} compatibility results.`;
      }, 120);
    });
  </script>
</Base>
