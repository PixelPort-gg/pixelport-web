---
import Base from '../layouts/Base.astro';

// Build-time snapshot from the GitHub dist releases — the same artifacts the app
// auto-updates from. The site deploys rarely, so this can go stale; a client-side
// fetch below refreshes the list on every page view, and this snapshot is the
// graceful fallback when the GitHub API is unreachable or rate-limited.
let releases: any[] = [];
try {
  const r = await fetch('https://api.github.com/repos/PixelPort-gg/pixelport-dist/releases?per_page=40', {
    headers: { 'User-Agent': 'pixelport.gg', Accept: 'application/vnd.github+json' },
  });
  if (r.ok) releases = (await r.json()).filter((x: any) => !x.draft);
} catch {
  // Offline / rate-limited build: render the page shell with a link out.
}

const fmtDate = (s: string) =>
  new Date(s).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dmg = (rel: any) => (rel.assets || []).find((a: any) => a.name?.endsWith('.dmg'));
const clean = (body: string) =>
  (body || '')
    .replace(/\r/g, '')
    .replace(/^#+\s*/gm, '')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .trim();
---

<Base title="Release notes" description="Every Pixel Port release and what changed. Download the latest, or see the full version history.">
  <section class="wrap py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Release notes</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      What has changed in Pixel Port, newest first. Updates land automatically in the app; this is the
      running history.
    </p>
    <a
      href="/download"
      class="mt-7 inline-block rounded-full bg-linear-to-r from-accent to-accent-2 px-7 py-3.5 font-semibold text-white shadow-[var(--shadow-glow)] [text-shadow:0_1px_2px_rgba(10,8,22,0.4)] transition-[transform,filter] hover:brightness-110 active:scale-[0.98]"
    >
      Download the latest
    </a>
    <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
      <span>Free during the beta</span>
      <span class="text-fg/20" aria-hidden="true">&middot;</span>
      <span>Apple Silicon, macOS 14+</span>
    </div>

    <div id="release-list">
      {
        releases.length === 0 ? (
          <p class="mt-12 text-muted">
            Could not load the release list right now — the full history lives on <a href="https://github.com/PixelPort-gg/pixelport-dist/releases" class="text-accent-2 hover:underline">GitHub</a>.
          </p>
        ) : (
          <ol class="mt-12 space-y-px overflow-hidden rounded-2xl border border-line">
            {releases.map((rel, i) => (
              <li id={rel.tag_name} class={`scroll-mt-24 p-6 sm:p-8 ${i === 0 ? 'bg-accent/[0.07]' : 'bg-surface/40'}`}>
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                  <div class="flex flex-wrap items-center gap-2.5">
                    <h2 class="rounded-lg border border-line bg-surface-2/70 px-2.5 py-1 font-mono text-sm font-semibold text-fg">
                      {rel.tag_name}
                    </h2>
                    {i === 0 && (
                      <span class="rounded-full bg-verified/15 px-2.5 py-0.5 text-xs font-semibold text-verified ring-1 ring-verified/35">
                        Latest
                      </span>
                    )}
                  </div>
                  <time class="text-sm text-muted">{fmtDate(rel.published_at)}</time>
                </div>
                {rel.name && rel.name !== rel.tag_name && (
                  <p class="mt-4 text-lg font-semibold text-fg">{rel.name}</p>
                )}
                {clean(rel.body) && (
                  <p class="mt-3 max-w-2xl whitespace-pre-wrap text-sm leading-relaxed text-fg/80">{clean(rel.body)}</p>
                )}
                {/* Only the LATEST release is downloadable — older versions are changelog-only
                    (everyone should start on the current build; /download always serves latest). */}
                {i === 0 && dmg(rel) && (
                  <a
                    href="/download"
                    class="mt-5 inline-block rounded-full border border-line bg-surface/60 px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent/40 hover:bg-surface"
                  >
                    Download {rel.tag_name}
                  </a>
                )}
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  <script>
    // Live refresh: the static build only re-fetches on deploy, so fetch the
    // current release list in the browser and re-render. On any failure
    // (offline, GitHub rate limit) the build-time snapshot above stays as-is.
    async function refreshReleases() {
      const root = document.getElementById('release-list');
      if (!root) return;

      let releases: any[];
      try {
        const r = await fetch(
          'https://api.github.com/repos/PixelPort-gg/pixelport-dist/releases?per_page=40',
          { headers: { Accept: 'application/vnd.github+json' } },
        );
        if (!r.ok) return;
        releases = (await r.json()).filter((x: any) => !x.draft);
      } catch {
        return;
      }
      if (!Array.isArray(releases) || releases.length === 0) return;

      const fmtDate = (s: string) =>
        new Date(s).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      const dmg = (rel: any) => (rel.assets || []).find((a: any) => a.name?.endsWith('.dmg'));
      const clean = (body: string) =>
        (body || '')
          .replace(/\r/g, '')
          .replace(/^#+\s*/gm, '')
          .replace(/\*\*(.*?)\*\*/g, '$1')
          .trim();

      const el = (tag: string, cls: string, text?: string) => {
        const n = document.createElement(tag);
        n.className = cls;
        if (text) n.textContent = text;
        return n;
      };

      const ol = el('ol', 'mt-12 space-y-px overflow-hidden rounded-2xl border border-line');
      releases.forEach((rel, i) => {
        const li = el('li', `scroll-mt-24 p-6 sm:p-8 ${i === 0 ? 'bg-accent/[0.07]' : 'bg-surface/40'}`);
        if (rel.tag_name) li.id = rel.tag_name;

        const head = el('div', 'flex flex-wrap items-center justify-between gap-x-4 gap-y-2');
        const title = el('div', 'flex flex-wrap items-center gap-2.5');
        title.appendChild(
          el(
            'h2',
            'rounded-lg border border-line bg-surface-2/70 px-2.5 py-1 font-mono text-sm font-semibold text-fg',
            rel.tag_name,
          ),
        );
        if (i === 0) {
          title.appendChild(
            el(
              'span',
              'rounded-full bg-verified/15 px-2.5 py-0.5 text-xs font-semibold text-verified ring-1 ring-verified/35',
              'Latest',
            ),
          );
        }
        head.appendChild(title);
        head.appendChild(el('time', 'text-sm text-muted', fmtDate(rel.published_at)));
        li.appendChild(head);

        if (rel.name && rel.name !== rel.tag_name) {
          li.appendChild(el('p', 'mt-4 text-lg font-semibold text-fg', rel.name));
        }

        const notes = clean(rel.body);
        if (notes) {
          li.appendChild(el('p', 'mt-3 max-w-2xl whitespace-pre-wrap text-sm leading-relaxed text-fg/80', notes));
        }

        // Only the latest release is downloadable — older versions render as changelog-only.
        const asset = dmg(rel);
        if (i === 0 && asset) {
          const a = el(
            'a',
            'mt-5 inline-block rounded-full border border-line bg-surface/60 px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent/40 hover:bg-surface',
            `Download ${rel.tag_name}`,
          ) as HTMLAnchorElement;
          a.href = '/download';
          li.appendChild(a);
        }

        ol.appendChild(li);
      });

      root.replaceChildren(ol);

      // The browser scrolled to any #tag anchor during initial load, but we just
      // rebuilt the list — re-run the scroll so a deep-linked release still lands.
      const hash = decodeURIComponent(location.hash.slice(1));
      if (hash) document.getElementById(hash)?.scrollIntoView();
    }

    refreshReleases();
  </script>
</Base>
