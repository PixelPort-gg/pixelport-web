---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/editorial/PageIntro.astro';

// Build-time snapshot from the GitHub dist releases - the same artifacts the app
// auto-updates from. The site deploys rarely, so this can go stale; a client-side
// fetch below refreshes the list on every page view, and this snapshot is the
// graceful fallback when the GitHub API is unreachable or rate-limited.
let releases: any[] = [];
try {
  const r = await fetch('https://api.github.com/repos/PixelPort-gg/pixelport-dist/releases?per_page=40', {
    headers: { 'User-Agent': 'pixelport.gg', Accept: 'application/vnd.github+json' },
  });
  if (r.ok) releases = (await r.json()).filter((x: any) => !x.draft);
} catch {
  // Offline / rate-limited build: render the page shell with a link out.
}

const fmtDate = (s: string) =>
  new Date(s).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dmg = (rel: any) => (rel.assets || []).find((a: any) => a.name?.endsWith('.dmg'));
const clean = (body: string) =>
  (body || '')
    .replace(/\r/g, '')
    .replace(/^#+\s*/gm, '')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\s+\u2014\s+/g, ': ')
    .replace(/\u2014/g, '-')
    .trim();
// Site style rule: no em dashes in rendered copy; release titles arrive from
// GitHub with them ("0.4.0 \u2014 The Redesign" becomes "0.4.0: The Redesign").
const deDashTitle = (name: string) =>
  (name || '').replace(/\s+\u2014\s+/g, ': ').replace(/\u2014/g, '-');
const releaseSignature = releases
  .map((rel) => `${rel.tag_name}:${rel.published_at}:${rel.updated_at}:${(rel.body || '').length}`)
  .join('|');
---

<Base title="Release notes" description="Every Pixel Port release and what changed. Download the latest, or see the full version history.">
  <PageIntro
    title="Release notes"
    description="What has changed in Pixel Port, newest first. Updates land automatically in the app; this is the running history."
  >
    <div slot="actions" class="release-actions">
      <a href="/download" class="primary-action">Download the latest</a>
      <a
        href="https://github.com/PixelPort-gg/pixelport-dist/releases"
        class="secondary-action"
        target="_blank"
        rel="noopener"
      >
        View on GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div slot="meta" class="release-meta">
      <span>Latest DMG</span>
      <span aria-hidden="true">·</span>
      <span>Apple Silicon, macOS 14+</span>
    </div>
  </PageIntro>

  <section class="release-section" aria-labelledby="release-title">
    <div class="release-heading">
      <div>
        <h2 id="release-title">Build history</h2>
        <p>Release notes are refreshed in your browser; the rendered snapshot remains if GitHub is unavailable.</p>
      </div>
    </div>

    <div id="release-list" data-release-signature={releaseSignature}>
      {
        releases.length === 0 ? (
          <p class="release-fallback">
            Could not load the release list right now. The full history lives on <a href="https://github.com/PixelPort-gg/pixelport-dist/releases">GitHub</a>.
          </p>
        ) : (
          <ol class="release-list">
            {releases.map((rel, i) => (
              <li id={rel.tag_name} class:list={['release-entry', { 'is-latest': i === 0 }]}>
                <div class="release-content">
                  <div class="release-topline">
                    <div class="release-version-row">
                      <h3 class="release-version">{rel.tag_name}</h3>
                      {i === 0 && <span class="latest-badge">Latest</span>}
                    </div>
                    <time class="release-date" datetime={rel.published_at}>{fmtDate(rel.published_at)}</time>
                  </div>
                  {rel.name && rel.name !== rel.tag_name && (
                    <p class="release-name">{deDashTitle(rel.name)}</p>
                  )}
                  {clean(rel.body) && <p class="release-notes">{clean(rel.body)}</p>}
                  {/* Only the LATEST release is downloadable; older versions are changelog-only
                      (everyone should start on the current build; /download always serves latest). */}
                  {i === 0 && dmg(rel) && (
                    <a href="/download" class="release-download">
                      Download {rel.tag_name} <span aria-hidden="true">↓</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  <script>
    // Live refresh: the static build only re-fetches on deploy, so fetch the
    // current release list in the browser and re-render. On any failure
    // (offline, GitHub rate limit) the build-time snapshot above stays as-is.
    async function refreshReleases() {
      const root = document.getElementById('release-list');
      if (!root) return;

      let releases: any[];
      try {
        const r = await fetch(
          'https://api.github.com/repos/PixelPort-gg/pixelport-dist/releases?per_page=40',
          { headers: { Accept: 'application/vnd.github+json' } },
        );
        if (!r.ok) return;
        releases = (await r.json()).filter((x: any) => !x.draft);
      } catch {
        return;
      }
      if (!Array.isArray(releases) || releases.length === 0) return;

      const signature = releases
        .map((rel: any) => `${rel.tag_name}:${rel.published_at}:${rel.updated_at}:${(rel.body || '').length}`)
        .join('|');
      if (root.dataset.releaseSignature === signature) return;

      const active = document.activeElement;
      const focusedHref = active instanceof HTMLAnchorElement && root.contains(active)
        ? active.getAttribute('href')
        : null;

      const fmtDate = (s: string) =>
        new Date(s).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      const dmg = (rel: any) => (rel.assets || []).find((a: any) => a.name?.endsWith('.dmg'));
      const clean = (body: string) =>
        (body || '')
          .replace(/\r/g, '')
          .replace(/^#+\s*/gm, '')
          .replace(/\*\*(.*?)\*\*/g, '$1')
          .replace(/\s+\u2014\s+/g, ': ')
          .replace(/\u2014/g, '-')
          .trim();
      const deDashTitle = (name: string) =>
        (name || '').replace(/\s+\u2014\s+/g, ': ').replace(/\u2014/g, '-');

      const el = (tag: string, cls: string, text?: string) => {
        const node = document.createElement(tag);
        node.className = cls;
        if (text) node.textContent = text;
        return node;
      };

      const ol = el('ol', 'release-list');
      releases.forEach((rel, i) => {
        const li = el('li', `release-entry${i === 0 ? ' is-latest' : ''}`);
        if (rel.tag_name) li.id = rel.tag_name;

        const content = el('div', 'release-content');
        const topline = el('div', 'release-topline');
        const versionRow = el('div', 'release-version-row');
        versionRow.appendChild(el('h3', 'release-version', rel.tag_name));
        if (i === 0) versionRow.appendChild(el('span', 'latest-badge', 'Latest'));
        topline.appendChild(versionRow);

        const time = el('time', 'release-date', fmtDate(rel.published_at)) as HTMLTimeElement;
        time.dateTime = rel.published_at;
        topline.appendChild(time);
        content.appendChild(topline);

        if (rel.name && rel.name !== rel.tag_name) {
          content.appendChild(el('p', 'release-name', deDashTitle(rel.name)));
        }

        const notes = clean(rel.body);
        if (notes) content.appendChild(el('p', 'release-notes', notes));

        // Only the latest release is downloadable; older versions render as changelog-only.
        const asset = dmg(rel);
        if (i === 0 && asset) {
          const a = el('a', 'release-download') as HTMLAnchorElement;
          a.href = '/download';
          a.append(document.createTextNode(`Download ${rel.tag_name} `));
          const arrow = el('span', '', '↓');
          arrow.setAttribute('aria-hidden', 'true');
          a.appendChild(arrow);
          content.appendChild(a);
        }

        li.appendChild(content);
        ol.appendChild(li);
      });

      root.replaceChildren(ol);
      root.dataset.releaseSignature = signature;

      if (focusedHref) {
        const replacement = [...root.querySelectorAll<HTMLAnchorElement>('a')]
          .find((link) => link.getAttribute('href') === focusedHref);
        replacement?.focus({ preventScroll: true });
      }

      // The browser scrolled to any #tag anchor during initial load, but we just
      // rebuilt the list; re-run the scroll so a deep-linked release still lands.
      const hash = decodeURIComponent(location.hash.slice(1));
      if (hash && !focusedHref) document.getElementById(hash)?.scrollIntoView();
    }

    refreshReleases();
  </script>

  <style>
    .release-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 2rem;
    }

    .primary-action,
    .secondary-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.85rem;
      padding-inline: 1.25rem;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 680;
      text-decoration: none;
      transition: border-color 160ms ease, filter 160ms ease, background-color 160ms ease;
    }

    .primary-action {
      background: linear-gradient(100deg, var(--color-accent), var(--color-accent-2));
      color: var(--color-ink);
    }

    .primary-action:hover {
      filter: brightness(1.08);
    }

    .secondary-action {
      gap: 0.45rem;
      border: 1px solid var(--color-line);
      background: color-mix(in srgb, var(--color-surface) 48%, transparent);
      color: var(--color-fg);
    }

    .secondary-action:hover {
      border-color: color-mix(in srgb, var(--color-accent-2) 45%, transparent);
      background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    }

    .release-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-top: 1.15rem;
      color: var(--color-muted);
      font-size: 0.75rem;
    }

    .release-meta > span[aria-hidden='true'] {
      color: color-mix(in srgb, var(--color-muted) 55%, transparent);
    }

    .release-section {
      width: min(68rem, calc(100% - 3rem));
      margin-inline: auto;
      padding-block: clamp(4.5rem, 9vw, 8rem) 2rem;
    }

    .release-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: clamp(2.75rem, 6vw, 5rem);
    }

    .release-heading h2 {
      margin: 0;
      color: var(--color-fg);
      font-size: clamp(1.7rem, 4vw, 2.7rem);
      font-weight: 620;
      letter-spacing: -0.05em;
    }

    .release-heading p {
      max-width: 39rem;
      margin: 0.65rem 0 0;
      color: var(--color-muted);
      font-size: 0.875rem;
      line-height: 1.6;
    }

    :global(#release-list .release-list) {
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--color-line);
      list-style: none;
    }

    :global(#release-list .release-entry) {
      scroll-margin-top: 6rem;
      padding-block: clamp(1.8rem, 4vw, 3rem);
      border-bottom: 1px solid var(--color-line);
    }

    :global(#release-list .release-entry.is-latest) {
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      border: 1px solid color-mix(in srgb, var(--color-accent) 26%, transparent);
      border-radius: 1.25rem;
      background:
        linear-gradient(110deg, rgba(146, 104, 255, 0.09), rgba(63, 214, 206, 0.025) 55%, transparent),
        color-mix(in srgb, var(--color-surface) 32%, transparent);
    }

    :global(#release-list .release-topline) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem 1.5rem;
    }

    :global(#release-list .release-version-row) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
    }

    :global(#release-list .release-version) {
      margin: 0;
      color: var(--color-fg);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      font-weight: 650;
      letter-spacing: -0.025em;
    }

    :global(#release-list .latest-badge) {
      padding: 0.28rem 0.58rem;
      border: 1px solid color-mix(in srgb, var(--color-verified) 38%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-verified) 11%, transparent);
      color: var(--color-verified);
      font-size: 0.5625rem;
      font-weight: 750;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    :global(#release-list .release-date) {
      color: var(--color-muted);
      font-size: 0.75rem;
    }

    :global(#release-list .release-name) {
      margin: 1.2rem 0 0;
      color: var(--color-fg);
      font-size: 1rem;
      font-weight: 620;
      letter-spacing: -0.015em;
    }

    :global(#release-list .release-notes) {
      max-width: 46rem;
      margin: 0.85rem 0 0;
      color: color-mix(in srgb, var(--color-fg) 78%, transparent);
      font-size: 0.875rem;
      line-height: 1.7;
      white-space: pre-wrap;
    }

    :global(#release-list .release-download) {
      display: inline-flex;
      align-items: center;
      gap: 1.1rem;
      min-height: 2.75rem;
      margin-top: 1.4rem;
      padding: 0.1rem 0;
      border-bottom: 1px solid color-mix(in srgb, var(--color-accent-2) 55%, transparent);
      color: var(--color-fg);
      font-size: 0.8125rem;
      font-weight: 620;
      text-decoration: none;
    }

    :global(#release-list .release-download:hover) {
      border-color: var(--color-accent-2);
      color: var(--color-accent-2);
    }

    :global(#release-list .release-fallback) {
      margin: 0;
      padding: 1.35rem 1.5rem;
      border-left: 2px solid var(--color-attention);
      background: color-mix(in srgb, var(--color-surface) 34%, transparent);
      color: var(--color-muted);
      font-size: 0.875rem;
      line-height: 1.6;
    }

    :global(#release-list .release-fallback a) {
      color: var(--color-accent-2);
      text-underline-offset: 0.18em;
    }

    @media (max-width: 42rem) {
      .release-section {
        width: min(100% - 2rem, 68rem);
      }

      .release-heading {
        align-items: start;
        flex-direction: column;
      }

      :global(#release-list .release-entry.is-latest) {
        margin-inline: -0.5rem;
        padding-inline: 0.75rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .primary-action,
      .secondary-action {
        transition: none;
      }
    }
  </style>
</Base>
