---
import Base from '../layouts/Base.astro';
import games from '../data/games.json';

// Placeholder figures — wire to the live catalogue/telemetry later.
const stats = [
  { label: 'Games tracked', value: '10,700+' },
  { label: 'Verified on Mac', value: '49' },
  { label: 'Playable on Mac', value: '10,600+' },
  { label: 'Runtime', value: 'Free (Wine 11 + DXMT)' },
];
const verified = games.filter((g) => g.tier === 'verified').length;
---

<Base title="Porting stats" description="How many Windows games run on Mac through Pixel Port, and how well.">
  <section class="wrap py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Porting stats</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      A live picture of what runs on Mac through Pixel Port. These numbers will wire to the real
      catalogue and telemetry as we open up.
    </p>

    <dl class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="rounded-2xl border border-line bg-surface/50 p-6">
            <dt class="text-sm text-muted">{s.label}</dt>
            <dd class="mt-2 bg-linear-to-r from-accent to-accent-2 bg-clip-text text-3xl font-bold text-transparent">
              {s.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-8 text-sm text-muted">
      Sample of {verified} verified title{verified === 1 ? '' : 's'} shown in the
      <a href="/games" class="text-accent-2 hover:underline">games catalogue</a>.
    </p>
  </section>
</Base>
