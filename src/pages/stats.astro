---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const grid = JSON.parse(
  readFileSync(join(process.cwd(), 'public/catalogue-grid.json'), 'utf8'),
) as { tier: string }[];
const c = grid.reduce<Record<string, number>>((m, g) => ((m[g.tier] = (m[g.tier] || 0) + 1), m), {});
const fmt = (n: number) => n.toLocaleString('en-US');

const stats = [
  { label: 'Games graded', value: fmt(grid.length) },
  { label: 'Verified on a real Mac', value: fmt(c.verified || 0) },
  { label: 'Playable', value: fmt(c.playable || 0) },
  { label: 'Price during beta', value: 'Free' },
];
---

<Base title="Porting stats" description="How many Windows games run on Mac through Pixel Port, and how well.">
  <section class="wrap py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Porting stats</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      A picture of what runs on Mac through Pixel Port. Tiers are graded honestly from real launches
      and trusted compatibility reports; only an on-device run flips a game to verified.
    </p>

    <dl class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="rounded-2xl border border-line bg-surface/50 p-6">
            <dt class="text-sm text-muted">{s.label}</dt>
            <dd class="mt-2 bg-linear-to-r from-accent to-accent-2 bg-clip-text text-3xl font-bold text-transparent">
              {s.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-8 text-sm text-muted">
      {fmt((c['needs-attention'] || 0) + (c.unsupported || 0))} more are flagged needs-attention or
      unsupported, so you always know before you install. Browse them all in the{' '}
      <a href="/games" class="text-accent-2 hover:underline">catalogue</a>.
    </p>
  </section>
</Base>
